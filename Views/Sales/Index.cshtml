@model CarePlusPharmacy.Models.PaginatedList<Sale>
@{
    ViewData["Title"] = "Sales & POS Transactions";
    decimal totalRevenue = ViewBag.TotalRevenueAll ?? 0m;
    int totalCount = ViewBag.TotalCountAll ?? 0;
    int totalItems = ViewBag.TotalItemsAll ?? 0;
    int totalPoints = ViewBag.TotalPointsAll ?? 0;
}

<!-- Summary Statistics -->
<div class="d-flex flex-wrap gap-3 mb-4">
    <div class="stat-card">
        <div class="stat-icon icon-green">
            <i class="bi bi-wallet2"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Total POS Revenue</div>
            <div class="stat-value">₱@totalRevenue.ToString("N2")</div>
        </div>
        <div class="stat-footer">
            <span class="text-success fw-bold">+14%</span> vs yesterday
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-blue">
            <i class="bi bi-receipt"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Transactions Count</div>
            <div class="stat-value">@totalCount</div>
        </div>
        <div class="stat-footer">
            <span class="text-info fw-bold"><i class="bi bi-cart-check"></i> Completed</span> orders
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-dark">
            <i class="bi bi-box-seam"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Medicines Dispensed</div>
            <div class="stat-value">@totalItems <span style="font-size: 13px; font-weight: 500; color: #7b809a;">units</span></div>
        </div>
        <div class="stat-footer">
            <span class="text-success fw-bold">+5%</span> volume growth
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-amber">
            <i class="bi bi-gift"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Loyalty Points Issued</div>
            <div class="stat-value text-warning">@totalPoints <span style="font-size: 13px; font-weight: 500; color: #7b809a;">pts</span></div>
        </div>
        <div class="stat-footer">
            <span class="text-warning fw-bold"><i class="bi bi-stars"></i> Rewarded</span> patients
        </div>
    </div>
</div>

<div class="table-card mb-3">
    <div class="p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label mb-1 text-muted" style="font-size: 11px; font-weight: 700;">SEARCH</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@(ViewBag.Search)" class="form-control border-start-0" placeholder="Customer name, sale #, or invoice #..." />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1 text-muted" style="font-size: 11px; font-weight: 700;">PAYMENT METHOD</label>
                <select name="paymentMethod" class="form-select form-select-sm">
                    <option value="">All Methods</option>
                    <option value="Cash" selected="@(ViewBag.PaymentMethod == "Cash")">Cash</option>
                    <option value="GCash" selected="@(ViewBag.PaymentMethod == "GCash")">GCash</option>
                    <option value="Card" selected="@(ViewBag.PaymentMethod == "Card")">Card</option>
                    <option value="PayMongo" selected="@(ViewBag.PaymentMethod == "PayMongo")">PayMongo</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1 text-muted" style="font-size: 11px; font-weight: 700;">STATUS</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                    <option value="Voided" selected="@(ViewBag.Status == "Voided")">Voided</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1 text-muted" style="font-size: 11px; font-weight: 700;">FROM</label>
                <input type="date" name="from" value="@(ViewBag.From)" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1 text-muted" style="font-size: 11px; font-weight: 700;">TO</label>
                <input type="date" name="to" value="@(ViewBag.To)" class="form-control form-control-sm" />
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-careplus flex-fill"><i class="bi bi-funnel me-1"></i>Apply</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="table-card">
    <div class="table-card-header">
        <div>
            <div class="fw-bold fs-6" style="color: var(--cp-forest-deep);"><i class="bi bi-clock-history text-success me-2"></i>Sales Ledger &amp; Dispensing Records</div>
            <div class="text-muted" style="font-size: 12px;">Real-time log of POS transactions with automatic batch and inventory deductions</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-careplus d-inline-flex align-items-center gap-1">
                <i class="bi bi-cart-plus"></i> Open POS Terminal
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Invoice / Sale #</th>
                    <th>Date &amp; Time</th>
                    <th>Customer &amp; Tier</th>
                    <th>Payment Method</th>
                    <th>Items Dispensed</th>
                    <th class="num">Net Amount</th>
                    <th>Cashier</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-5">
                            <i class="bi bi-cart-x fs-2 d-block mb-2 text-muted"></i>
                            No sales records found.
                        </td>
                    </tr>
                }
                @foreach (var s in Model)
                {
                    <tr class="@(s.IsVoided ? "table-light opacity-75" : "")">
                        <td>
                            <span class="fw-bold text-dark">#@s.Id</span>
                            <div class="text-muted" style="font-size: 11px;">
                                @(s.Billing?.InvoiceNumber ?? $"INV-{s.Id:D5}")
                            </div>
                            @if (s.IsVoided)
                            {
                                <span class="badge mt-1" style="background: var(--cp-danger-bg); color: var(--cp-danger);" title="@s.VoidReason">
                                    <i class="bi bi-slash-circle me-1"></i>VOIDED
                                </span>
                            }
                        </td>
                        <td>
                            <div>@s.SaleDate.ToString("yyyy-MM-dd")</div>
                            <div class="text-muted" style="font-size: 11px;">@s.SaleDate.ToString("hh:mm tt")</div>
                        </td>
                        <td>
                            @if (s.Customer != null)
                            {
                                <div class="fw-semibold text-dark">@s.Customer.FullName</div>
                                <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 10px;">
                                    @s.Customer.Tier
                                </span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Walk-in</span>
                            }
                        </td>
                        <td>
                            @if (s.PaymentMethod == "Cash")
                            {
                                <span class="badge bg-light text-dark border"><i class="bi bi-cash me-1"></i>Cash</span>
                            }
                            else if (s.PaymentMethod == "GCash")
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-phone me-1"></i>GCash</span>
                            }
                            else if (s.PaymentMethod == "Card")
                            {
                                <span class="badge bg-info-subtle text-info border border-info-subtle"><i class="bi bi-credit-card me-1"></i>Card</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-shield-check me-1"></i>PayMongo</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@s.Details.Count item(s)</span>
                            <div class="text-muted text-truncate" style="font-size: 11.5px; max-width: 220px;" title="@string.Join(", ", s.Details.Select(d => $"{d.Medicine?.Name} ({d.Quantity})"))">
                                @string.Join(", ", s.Details.Select(d => $"{d.Medicine?.Name} ({d.Quantity})"))
                            </div>
                        </td>
                        <td class="num">
                            <div class="fw-bold fs-6 @(s.IsVoided ? "text-decoration-line-through text-muted" : "text-dark")">₱@s.TotalAmount.ToString("N2")</div>
                            @if (s.DiscountAmount > 0)
                            {
                                <div class="text-success" style="font-size: 11px;">-₱@s.DiscountAmount.ToString("N2") disc.</div>
                            }
                            @if (s.IsVoided)
                            {
                                <div class="text-danger" style="font-size: 11px;" title="@s.VoidReason">Refunded</div>
                            }
                        </td>
                        <td>
                            <span class="text-muted" style="font-size: 12px;">@(s.Cashier?.FullName ?? s.Cashier?.UserName ?? "Staff")</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-careplus py-1 px-2" style="font-size: 12px;">
                                <i class="bi bi-receipt me-1"></i> Receipt
                            </a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Pharmacist"))
                            {
                                if (!s.IsVoided)
                                {
                                    <form method="post" asp-action="Void" asp-route-id="@s.Id" class="d-inline"
                                          onsubmit="var r = prompt('Reason for voiding Sale #@s.Id (required):',''); if(!r || !r.trim()){alert('A reason is required.'); return false;} this.querySelector('[name=voidReason]').value = r.trim(); return confirm('Voiding returns stock to inventory, reverses loyalty points, and refunds the invoice. Continue?');">
                                        <input type="hidden" name="voidReason" value="" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 12px;" title="Void / refund this sale">
                                            <i class="bi bi-slash-circle"></i> Void
                                        </button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", Model)
</div>
