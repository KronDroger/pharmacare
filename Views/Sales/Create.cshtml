@{
    ViewData["Title"] = "POS Terminal";
    var customers = ViewBag.Customers as List<CarePlusPharmacy.Models.Customer> ?? new();
    var categories = ViewBag.Categories as List<string> ?? new();
    var rx = ViewBag.Prescription as CarePlusPharmacy.Models.Prescription;
}

@if (rx != null)
{
    <div class="alert alert-info border-0 shadow-sm d-flex align-items-center justify-content-between mb-3" style="background:#e0f2fe; border-radius: 12px;">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-file-earmark-medical-fill fs-4 text-primary"></i>
            <div>
                <strong>Dispensing Prescription #@rx.Id</strong> for patient <strong>@rx.Customer?.FullName</strong> (Dr. @rx.DoctorName)
                <div style="font-size: 12px;" class="text-muted">Prescription items have been pre-loaded into your active cart below.</div>
            </div>
        </div>
        <span class="badge bg-primary">Prescription Linked</span>
    </div>
}

<div class="pos-container">
    <!-- Left Column: Medicine Catalog & Quick Search -->
    <div>
        <div class="card border-0 shadow-sm mb-3" style="border-radius: var(--radius-lg);">
            <div class="card-body p-3">
                <div class="row g-2 align-items-center">
                    <div class="col-md-7">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" id="medSearch" class="form-control border-start-0 ps-0" placeholder="Search by Brand name, Generic name, or Manufacturer..." oninput="onMedSearchInput()" />
                        </div>
                    </div>
                    <div class="col-md-5">
                        <select id="catFilter" class="form-select" onchange="loadMeds(true)">
                            <option value="">All Categories</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat">@cat</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Medicine Grid -->
        <div class="row g-3" id="medGrid"></div>

        <!-- Grid Pager -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mt-3" id="medPager"></div>
    </div>

    <!-- Right Column: Active Cart & Checkout Panel -->
    <div class="pos-cart-panel">
        <div class="pos-cart-header">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold fs-6 text-dark"><i class="bi bi-cart3 text-success me-2"></i>Active Cart</span>
                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 11px;" onclick="clearCart()">
                    Clear All
                </button>
            </div>

            <!-- Customer / CRM Select -->
            <label class="form-label mb-1 text-muted" style="font-size: 11.5px; font-weight: 600;">CUSTOMER / PATIENT</label>
            <select id="customerSelect" class="form-select form-select-sm" onchange="onCustomerChange()">
                <option value="" data-points="0" data-tier="None">Walk-in Customer (No CRM)</option>
                @foreach (var c in customers)
                {
                    var selected = rx != null && rx.CustomerId == c.Id ? "selected" : "";
                    <option value="@c.Id" data-points="@c.LoyaltyPoints" data-tier="@c.Tier" selected="@(rx != null && rx.CustomerId == c.Id)">
                        @c.FullName (@c.Tier - @c.LoyaltyPoints pts)
                    </option>
                }
            </select>

            <!-- Customer Loyalty Card Preview -->
            <div id="crmCustomerCard" class="mt-2 p-2 rounded d-none" style="background: var(--cp-mint-subtle); border: 1px solid rgba(16, 185, 129, 0.3);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span id="crmTierBadge" class="badge-tier-silver">Silver</span>
                        <span class="text-dark fw-bold ms-1" style="font-size: 12px;"><span id="crmPointsAvailable">0</span> pts</span>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="usePointsSwitch" onchange="updateSummary()" />
                        <label class="form-check-label" for="usePointsSwitch" style="font-size: 11.5px; font-weight: 600;">Redeem Pts</label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cart Items List -->
        <div class="pos-cart-body" id="cartItemsContainer">
            <div class="text-center py-5 text-muted" id="emptyCartMsg">
                <i class="bi bi-bag-x fs-1 d-block mb-2 text-muted opacity-50"></i>
                <div>Cart is empty</div>
                <div style="font-size: 12px;">Select medicines on the left to add</div>
            </div>
            <div id="cartList"></div>
        </div>

        <!-- Cart Summary & Payment -->
        <div class="pos-cart-footer">
            <div class="alert alert-danger py-1 px-2 mb-2 d-none" id="pricingError" style="font-size: 11.5px;">
                <i class="bi bi-exclamation-triangle me-1"></i>Live pricing unavailable, so the cart cannot be totalled. Checkout is blocked — adjust the cart or reload the page.
            </div>
            <div class="d-flex justify-content-between mb-1" style="font-size: 13px;">
                <span class="text-muted">Subtotal:</span>
                <span class="fw-semibold text-dark">₱<span id="subtotalDisplay">0.00</span></span>
            </div>
            <div class="d-flex justify-content-between mb-1 text-warning d-none" id="bogoRow" style="font-size: 13px;">
                <span id="bogoLabel">BOGO Savings (near expiry):</span>
                <span>-₱<span id="bogoDisplay">0.00</span></span>
            </div>
            <div class="d-flex justify-content-between mb-1 text-primary d-none" id="statDiscountRow" style="font-size: 13px;">
                <span id="statDiscountLabel">Senior/PWD Discount (20%):</span>
                <span>-₱<span id="statDiscountDisplay">0.00</span></span>
            </div>
            <div class="d-flex justify-content-between mb-1 text-success d-none" id="discountRow" style="font-size: 13px;">
                <span>Points Discount:</span>
                <span>-₱<span id="discountDisplay">0.00</span></span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3 pt-2 border-top">
                <span class="fw-bold fs-6">Net Payable:</span>
                <span class="fw-bold fs-4 text-success">₱<span id="netTotalDisplay">0.00</span></span>
            </div>

            <!-- Statutory Discount (Senior Citizen / PWD) -->
            <div class="mb-2 p-2 rounded" style="background: var(--cp-mint-subtle); border: 1px solid rgba(16, 185, 129, 0.25);">
                <label class="form-label mb-1 text-muted" style="font-size: 11px; font-weight: 700;">STATUTORY DISCOUNT (20%)</label>
                <select id="discountTypeSelect" class="form-select form-select-sm mb-2" onchange="onDiscountChange()">
                    <option value="None" selected>None — Standard Price</option>
                    <option value="Senior">Senior Citizen</option>
                    <option value="Pwd">Person with Disability (PWD)</option>
                </select>
                <div id="discountIdArea" class="d-none">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text" style="background: var(--cp-surface-elevated);"><i class="bi bi-person-vcard text-muted"></i></span>
                        <input type="text" id="discountIdInput" class="form-control" maxlength="30" placeholder="ID Number (required)" />
                    </div>
                    <div class="text-muted mt-1" style="font-size: 10.5px;"><i class="bi bi-info-circle me-1"></i>e.g. OSCA/PWD ID number — verified before checkout</div>
                </div>
            </div>

            <!-- Payment Method Select -->
            <div class="mb-2">
                <label class="form-label mb-1 text-muted" style="font-size: 11px; font-weight: 700;">PAYMENT METHOD</label>
                <div class="btn-group w-100" role="group">
                    <input type="radio" class="btn-check" name="payMethod" id="payCash" value="Cash" checked onchange="onPaymentMethodChange()" />
                    <label class="btn btn-outline-secondary btn-sm" for="payCash"><i class="bi bi-cash me-1"></i>Cash</label>

                    <input type="radio" class="btn-check" name="payMethod" id="payGCash" value="GCash" onchange="onPaymentMethodChange()" />
                    <label class="btn btn-outline-secondary btn-sm" for="payGCash"><i class="bi bi-phone me-1"></i>GCash</label>

                    <input type="radio" class="btn-check" name="payMethod" id="payCard" value="Card" onchange="onPaymentMethodChange()" />
                    <label class="btn btn-outline-secondary btn-sm" for="payCard"><i class="bi bi-credit-card me-1"></i>Card</label>

                    <input type="radio" class="btn-check" name="payMethod" id="payMongo" value="PayMongo" onchange="onPaymentMethodChange()" />
                    <label class="btn btn-outline-secondary btn-sm" for="payMongo"><i class="bi bi-shield-check me-1"></i>PayMongo</label>
                </div>
            </div>

            <!-- Cash Tendered & Change -->
            <div id="cashCalcArea">
                <div class="input-group input-group-sm mb-2">
                    <span class="input-group-text bg-white">Cash Tendered ₱</span>
                    <input type="number" id="cashTendered" class="form-control num text-end fw-bold" placeholder="0.00" oninput="updateChange()" />
                </div>
                <div class="d-flex gap-1 mb-2">
                    <button type="button" class="btn btn-sm btn-light border flex-fill py-0" style="font-size: 11px;" onclick="setTenderedExact()">Exact</button>
                    <button type="button" class="btn btn-sm btn-light border flex-fill py-0" style="font-size: 11px;" onclick="addTendered(100)">+100</button>
                    <button type="button" class="btn btn-sm btn-light border flex-fill py-0" style="font-size: 11px;" onclick="addTendered(500)">+500</button>
                    <button type="button" class="btn btn-sm btn-light border flex-fill py-0" style="font-size: 11px;" onclick="addTendered(1000)">+1k</button>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3 p-2 rounded bg-light border">
                    <span class="text-muted" style="font-size: 12px; font-weight: 600;">Change:</span>
                    <span class="fw-bold text-dark fs-6">₱<span id="changeDisplay">0.00</span></span>
                </div>
            </div>

            <button type="button" id="btnCheckout" class="btn btn-careplus w-100 py-2 fs-6" disabled onclick="submitCheckout()">
                <i class="bi bi-check2-circle me-1"></i> Complete Checkout &amp; Receipt
            </button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
    let cart = [];
    let prescriptionId = @(rx != null ? rx.Id : 0);

    // Initial Rx pre-load if provided
    @if (rx != null)
    {
        foreach (var d in rx.Details)
        {
            <text>
            addToCart(@d.MedicineId, '@d.Medicine?.Name.Replace("'", "\\'")', @(d.Medicine?.UnitPrice ?? 0), @(d.Medicine?.TotalStock ?? 999), @d.Quantity, @(d.Medicine?.IsVatExempt == true ? "true" : "false"), @(d.Medicine?.RxRequired == true ? "true" : "false"));
            </text>
        }
    }

    function filterMeds() { loadMeds(true); }

    let medPage = 1;
    const medPageSize = 12;
    let medTotalPages = 1;
    let medTotalCount = 0;
    let medSearchTimer = null;

    function onMedSearchInput() {
        clearTimeout(medSearchTimer);
        medSearchTimer = setTimeout(() => loadMeds(true), 300);
    }

    function loadMeds(resetPage = false) {
        if (resetPage) medPage = 1;

        const query = document.getElementById('medSearch')?.value.trim() || '';
        const cat = document.getElementById('catFilter')?.value || '';
        const grid = document.getElementById('medGrid');
        const pager = document.getElementById('medPager');

        if (grid) {
            grid.innerHTML = '<div class="col-12 text-center text-muted py-5"><div class="spinner-border spinner-border-sm text-success me-2"></div>Loading medicines...</div>';
        }

        const url = '@Url.Action("Medicines", "Sales")'
            + `?page=${medPage}&pageSize=${medPageSize}`
            + `&search=${encodeURIComponent(query)}`
            + `&category=${encodeURIComponent(cat)}`;

        fetch(url)
            .then(r => r.json())
            .then(d => {
                medTotalPages = d.totalPages;
                medTotalCount = d.totalCount;
                renderMedicineCards(d.data || []);
                renderMedPager();
            })
            .catch(() => {
                if (grid) grid.innerHTML = '<div class="col-12 text-center text-danger py-5">Failed to load medicines. Please try again.</div>';
            });
    }

    function renderMedicineCards(list) {
        const grid = document.getElementById('medGrid');
        if (!grid) return;

        if (!list.length) {
            grid.innerHTML = '<div class="col-12 text-center text-muted py-5">' +
                '<i class="bi bi-search fs-2 d-block mb-2 text-muted"></i>' +
                'No medicines match your search.</div>';
            return;
        }

        const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        const todayPlus45 = Date.now() + (45 * 24 * 60 * 60 * 1000);

        let html = '';
        list.forEach(med => {
            const sellableStock = Number(med.sellableStock) || 0;
            const isOutOfStock = sellableStock <= 0;
            const isLowStock = !isOutOfStock && sellableStock <= med.reorderLevel;
            const nearExp = med.nearestExpiry ? new Date(med.nearestExpiry + 'T00:00:00') : null;
            const isNearExp = nearExp && nearExp.getTime() <= todayPlus45;

            let stockBadge;
            if (isOutOfStock) stockBadge = '<span class="badge bg-danger">Out of Stock</span>';
            else if (isLowStock) stockBadge = '<span class="badge bg-warning text-dark">Low: ' + sellableStock + '</span>';
            else stockBadge = '<span class="badge bg-success-subtle text-success border border-success-subtle">Stock: ' + sellableStock + '</span>';

            const expiredUnits = Number(med.expiredStock) || 0;
            const expiredNote = expiredUnits > 0
                ? '<span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1" title="' + expiredUnits + ' expired units are not sellable">' + expiredUnits + ' exp.</span>'
                : '';
            const vatBadge = med.isVatExempt
                ? '<span class="badge ms-1" style="background: var(--cp-mint-subtle); color: var(--cp-forest);" title="VAT-Exempt medicine">No VAT</span>'
                : '';
            const rxBadge = med.rxRequired
                ? '<span class="badge ms-1" style="background: var(--cp-warning-bg); color: var(--cp-warning);" title="Requires prescription (Rx)">Rx</span>'
                : '';

            let genericLine = med.genericName || 'Standard Formula';
            let mfrLine = med.manufacturer ? '<div class="text-muted" style="font-size: 11px;"><i class="bi bi-building me-1"></i>' + med.manufacturer + '</div>' : '';
            let expLine = nearExp
                ? '<div class="mt-1" style="font-size: 11px;">Exp: <span class="' + (isNearExp ? 'text-danger fw-bold' : 'text-muted') + '">' + months[nearExp.getMonth()] + ' ' + nearExp.getFullYear() + '</span></div>'
                : '';

            const safeName = String(med.name).replace(/'/g, "\\'");
            const price = Number(med.unitPrice).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            html += '<div class="col-md-6 col-xl-4">' +
                '<div class="card h-100 border-0 shadow-sm p-3 d-flex flex-column justify-content-between" style="border-radius: var(--radius-md); transition: all 0.18s; border: 1px solid var(--cp-border);">' +
                '<div>' +
                '<div class="d-flex justify-content-between align-items-start mb-1">' +
                '<span class="badge bg-light text-muted border text-truncate" style="font-size: 10.5px; max-width: 140px;">' + med.category + '</span>' +
                '<span class="d-inline-flex align-items-center gap-1">' + stockBadge + vatBadge + rxBadge + expiredNote + '</span>' +
                '</div>' +
                '<div class="fw-bold fs-6 text-dark text-truncate" title="' + med.name + '">' + med.name + '</div>' +
                '<div class="text-muted text-truncate" style="font-size: 12px;" title="' + genericLine + '"><i class="bi bi-capsule me-1"></i>' + genericLine + '</div>' +
                mfrLine +
                expLine +
                '</div>' +
                '<div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">' +
                '<span class="fw-bold fs-5 text-success">₱' + price + '</span>' +
                '<button type="button" class="btn btn-sm ' + (isOutOfStock ? 'btn-secondary' : 'btn-careplus') + ' px-3" ' + (isOutOfStock ? 'disabled' : '') +
                ' onclick="addToCart(' + med.id + ', \'' + safeName + '\', ' + med.unitPrice + ', ' + sellableStock + ', 1, ' + (med.isVatExempt ? 'true' : 'false') + ', ' + (med.rxRequired ? 'true' : 'false') + ')">' +
                '<i class="bi bi-plus-lg me-1"></i> Add</button>' +
                '</div>' +
                '</div>' +
                '</div>';
        });

        grid.innerHTML = html;
    }

    function goMedPage(newPage) {
        if (newPage < 1 || newPage > medTotalPages) return;
        medPage = newPage;
        loadMeds(false);
    }

    function renderMedPager() {
        const pager = document.getElementById('medPager');
        if (!pager) return;

        const start = medTotalCount === 0 ? 0 : ((medPage - 1) * medPageSize) + 1;
        const end = Math.min(medPage * medPageSize, medTotalCount);

        pager.innerHTML =
            '<div class="text-muted" style="font-size: 12.5px;">Showing ' + start + '&ndash;' + end + ' of ' + medTotalCount + ' medicines</div>' +
            '<div class="d-flex gap-1 align-items-center">' +
            '<button type="button" class="btn btn-sm btn-outline-careplus py-1 px-3" onclick="goMedPage(' + (medPage - 1) + ')" ' + (medPage <= 1 ? 'disabled' : '') + '><i class="bi bi-chevron-left"></i></button>' +
            '<span class="fw-semibold px-2" style="font-size: 13px;">Page ' + medPage + ' / ' + medTotalPages + '</span>' +
            '<button type="button" class="btn btn-sm btn-outline-careplus py-1 px-3" onclick="goMedPage(' + (medPage + 1) + ')" ' + (medPage >= medTotalPages ? 'disabled' : '') + '><i class="bi bi-chevron-right"></i></button>' +
            '</div>';
    }

    function addToCart(medId, medName, price, maxStock, initialQty = 1, isVatExempt = false, rxRequired = false) {
        const existing = cart.find(i => i.medId === medId);
        if (existing) {
            if (existing.qty + initialQty <= maxStock) {
                existing.qty += initialQty;
            } else {
                alert(`Cannot add more. Only ${maxStock} units in stock.`);
            }
        } else {
            if (initialQty <= maxStock) {
                cart.push({ medId, medName, price, maxStock, qty: initialQty, isVatExempt: !!isVatExempt, rxRequired: !!rxRequired });
            } else {
                alert(`Cannot add. Only ${maxStock} units in stock.`);
            }
        }
        renderCart();
    }

    function changeQty(medId, delta) {
        const item = cart.find(i => i.medId === medId);
        if (!item) return;

        const newQty = item.qty + delta;
        if (newQty <= 0) {
            removeFromCart(medId);
        } else if (newQty <= item.maxStock) {
            item.qty = newQty;
            renderCart();
        } else {
            alert(`Maximum available stock is ${item.maxStock}`);
        }
    }

    function removeFromCart(medId) {
        cart = cart.filter(i => i.medId !== medId);
        renderCart();
    }

    function clearCart() {
        cart = [];
        renderCart();
    }

    // Authoritative per-line pricing for the cart, keyed by medicineId.
    //
    // Populated only by refreshPricing() from POST Sales/CartPricing, which runs the
    // same FEFO + BOGO pass that Checkout bills against. The client deliberately does
    // NOT recompute these: recomputing quantity x price in JavaScript is what made the
    // cart subtotal ignore the near-expiry BOGO halving and disagree with the receipt.
    let linePricing = {};
    let pricingFailed = false;
    let pricingSeq = 0;

    async function refreshPricing() {
        const seq = ++pricingSeq;

        if (cart.length === 0) {
            linePricing = {};
            pricingFailed = false;
            return true;
        }

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const resp = await fetch('@Url.Action("CartPricing", "Sales")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(cart.map(i => ({ medicineId: i.medId, quantity: i.qty })))
            });

            if (!resp.ok) throw new Error('CartPricing ' + resp.status);

            const data = await resp.json();
            // Guard against an out-of-order response overwriting newer pricing.
            if (seq !== pricingSeq) return true;

            const next = {};
            (data.lines || []).forEach(l => { next[l.medicineId] = l; });
            linePricing = next;
            pricingFailed = false;
            return true;
        } catch (err) {
            if (seq !== pricingSeq) return true;
            // Never fall back to quantity x price: that is precisely the bug this
            // endpoint removes, and a confidently wrong total is worse than an
            // explicit failure. Keep the last good pricing, flag the cart, and
            // block checkout.
            pricingFailed = true;
            return false;
        }
    }

    async function renderCart() {
        const emptyMsg = document.getElementById('emptyCartMsg');
        const cartList = document.getElementById('cartList');
        const btnCheckout = document.getElementById('btnCheckout');
        const pricingError = document.getElementById('pricingError');

        const priced = await refreshPricing();

        if (cart.length === 0) {
            emptyMsg.style.display = 'block';
            cartList.innerHTML = '';
            btnCheckout.disabled = true;
            pricingError.classList.add('d-none');
        } else {
            emptyMsg.style.display = 'none';
            btnCheckout.disabled = !priced;
            pricingError.classList.toggle('d-none', priced);

            let html = '';
            cart.forEach(item => {
                const p = linePricing[item.medId];

                if (!p) {
                    // No server figure for this line: show the unit price but no line
                    // total rather than inventing a full-price one.
                    html += `
                        <div class="pos-item-card">
                            <div style="flex: 1; min-width: 0;">
                                <div class="fw-bold text-dark text-truncate" style="font-size: 13px;">${item.medName}</div>
                                <div class="text-muted" style="font-size: 11.5px;">₱${item.price.toFixed(2)} each</div>
                                <div class="text-danger" style="font-size: 10.5px;">price unavailable</div>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <button type="button" class="btn btn-sm btn-light border py-0 px-2" onclick="changeQty(${item.medId}, -1)">-</button>
                                <span class="fw-bold px-1" style="font-size: 13px; min-width: 22px; text-align: center;">${item.qty}</span>
                                <button type="button" class="btn btn-sm btn-light border py-0 px-2" onclick="changeQty(${item.medId}, 1)">+</button>
                                <span class="text-muted ms-2" style="font-size: 12px; min-width: 55px; text-align: right;">—</span>
                                <button type="button" class="btn btn-sm text-danger border-0 p-0 ms-1" onclick="removeFromCart(${item.medId})">
                                    <i class="bi bi-x fs-5"></i>
                                </button>
                            </div>
                        </div>
                    `;
                    return;
                }

                // bogoUnits > 0 with no discount yet means the line is BOGO-eligible
                // but has not reached a pair yet (1 unit, or 1 of a split batch).
                const bogoApplied = p.bogoDiscount > 0;
                const bogoEligible = !bogoApplied && p.bogoUnits > 0;

                const batchNote = 'Batch ' + p.bogoBatch +
                    (p.bogoDate ? ' &middot; exp ' + p.bogoDate : '') +
                    (bogoApplied && p.bogoUnits < p.quantity ? ' &middot; ' + p.bogoUnits + ' of ' + p.quantity + ' units BOGO' : '');

                let bogoTag = '';
                if (bogoApplied) {
                    bogoTag = '<div class="mt-1"><span class="badge rounded-pill text-bg-warning" style="font-size: 10.5px;">' +
                        '<i class="bi bi-tag-fill me-1"></i>BOGO Buy 1 Take 1 applied</span>' +
                        '<span class="text-muted ms-1" style="font-size: 10.5px;">' + batchNote +
                        ' &middot; saved ₱' + p.bogoDiscount.toFixed(2) + '</span></div>';
                } else if (bogoEligible) {
                    bogoTag = '<div class="mt-1"><span class="badge rounded-pill text-bg-warning" style="font-size: 10.5px;">' +
                        '<i class="bi bi-tag-fill me-1"></i>BOGO Eligible (near expiry)</span>' +
                        '<span class="text-muted ms-1" style="font-size: 10.5px;">' + batchNote + '</span></div>';
                }

                // Struck-through full price beside the reduced payable when BOGO fired.
                const lineTotal = bogoApplied
                    ? '<span class="text-muted text-decoration-line-through" style="font-size: 11.5px;">₱' + p.lineTotal.toFixed(2) + '</span> ' +
                      '<span class="fw-bold text-success" style="font-size: 13px;">₱' + p.payable.toFixed(2) + '</span>'
                    : '<span class="fw-bold text-dark" style="font-size: 13px;">₱' + p.payable.toFixed(2) + '</span>';

                html += `
                    <div class="pos-item-card">
                        <div style="flex: 1; min-width: 0;">
                            <div class="fw-bold text-dark text-truncate" style="font-size: 13px;">${item.medName}</div>
                            <div class="text-muted" style="font-size: 11.5px;">₱${p.unitPrice.toFixed(2)} each</div>
                            ${bogoTag}
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <button type="button" class="btn btn-sm btn-light border py-0 px-2" onclick="changeQty(${item.medId}, -1)">-</button>
                            <span class="fw-bold px-1" style="font-size: 13px; min-width: 22px; text-align: center;">${item.qty}</span>
                            <button type="button" class="btn btn-sm btn-light border py-0 px-2" onclick="changeQty(${item.medId}, 1)">+</button>
                            <span class="ms-2" style="min-width: 55px; text-align: right;">${lineTotal}</span>
                            <button type="button" class="btn btn-sm text-danger border-0 p-0 ms-1" onclick="removeFromCart(${item.medId})">
                                <i class="bi bi-x fs-5"></i>
                            </button>
                        </div>
                    </div>
                `;
            });
            cartList.innerHTML = html;
        }

        updateSummary();
    }

    function onCustomerChange() {
        const select = document.getElementById('customerSelect');
        const card = document.getElementById('crmCustomerCard');
        const selected = select.options[select.selectedIndex];
        const points = parseInt(selected.dataset.points || '0', 10);
        const tier = selected.dataset.tier || '';

        if (select.value) {
            card.classList.remove('d-none');
            document.getElementById('crmPointsAvailable').innerText = points;
            document.getElementById('crmTierBadge').innerText = tier;
        } else {
            card.classList.add('d-none');
            document.getElementById('usePointsSwitch').checked = false;
        }
        updateSummary();
    }

    function onDiscountChange() {
        const type = document.getElementById('discountTypeSelect').value;
        const area = document.getElementById('discountIdArea');
        if (type !== 'None') {
            area.classList.remove('d-none');
        } else {
            area.classList.add('d-none');
            document.getElementById('discountIdInput').value = '';
        }
        updateSummary();
    }

    function updateSummary() {
        // All money figures below come from linePricing, i.e. the server's
        // FEFO + BOGO pass. Summing them keeps the on-screen subtotal equal to what
        // Checkout charges, including the near-expiry BOGO halving.
        const priced = cart.map(i => linePricing[i.medId]).filter(Boolean);

        const subtotal = priced.reduce((sum, p) => sum + Number(p.payable), 0);
        const bogoSavings = priced.reduce((sum, p) => sum + Number(p.bogoDiscount), 0);

        document.getElementById('subtotalDisplay').innerText = subtotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        if (bogoSavings > 0) {
            document.getElementById('bogoRow').classList.remove('d-none');
            document.getElementById('bogoDisplay').innerText = bogoSavings.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        } else {
            document.getElementById('bogoRow').classList.add('d-none');
        }

        const select = document.getElementById('customerSelect');
        const usePoints = document.getElementById('usePointsSwitch').checked;
        const availablePoints = parseInt(select.options[select.selectedIndex]?.dataset.points || '0', 10);

        // VAT pools + statutory Senior/PWD discount (mirrors the server-side PricingService).
        // Built from the BOGO-reduced payable amounts, so a statutory discount on a
        // BOGO line is taken on the amount actually owed — matching the server.
        const vatable = cart.reduce((sum, i) => {
            const p = linePricing[i.medId];
            if (!p || i.isVatExempt) return sum;
            return sum + Number(p.payable);
        }, 0);
        const exempt = cart.reduce((sum, i) => {
            const p = linePricing[i.medId];
            if (!p || !i.isVatExempt) return sum;
            return sum + Number(p.payable);
        }, 0);
        const discountType = document.getElementById('discountTypeSelect').value;

        let statDiscount = 0;
        if (discountType === 'Senior' || discountType === 'Pwd') {
            statDiscount = Math.round(0.20 * ((vatable / 1.12) + exempt) * 100) / 100;
            document.getElementById('statDiscountLabel').innerText = (discountType === 'Senior' ? 'Senior' : 'PWD') + ' Discount (20%):';
        }
        if (statDiscount > 0) {
            document.getElementById('statDiscountRow').classList.remove('d-none');
            document.getElementById('statDiscountDisplay').innerText = statDiscount.toFixed(2);
        } else {
            document.getElementById('statDiscountRow').classList.add('d-none');
        }

        // Senior/PWD: VAT is not collected on a statutory-discount purchase and the 20%
        // discount is taken on the VAT-exclusive amount, so the VAT component is removed
        // from the amount owed. Mirrors PricingService + Checkout on the server, and now
        // runs on the BOGO-reduced payable amounts rather than full line price.
        const vatAmount = Math.round((vatable / 1.12) * 0.12 * 100) / 100;
        const isStatutory = (discountType === 'Senior' || discountType === 'Pwd');

        // Amount owed before points — the same figure the server caps points against, so
        // the switch can never offer more points than Checkout will actually honour
        // (which previously burned points for no extra discount).
        const payableBeforePoints = Math.max(0, subtotal - statDiscount - (isStatutory ? vatAmount : 0));

        let discount = 0;
        if (usePoints && availablePoints > 0) {
            discount = Math.min(availablePoints, Math.floor(payableBeforePoints));
            document.getElementById('discountRow').classList.remove('d-none');
            document.getElementById('discountDisplay').innerText = discount.toFixed(2);
        } else {
            document.getElementById('discountRow').classList.add('d-none');
        }

        const netTotal = Math.max(0, payableBeforePoints - discount);
        document.getElementById('netTotalDisplay').innerText = netTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        updateChange();
    }

    function onPaymentMethodChange() {
        const method = document.querySelector('input[name="payMethod"]:checked').value;
        const cashArea = document.getElementById('cashCalcArea');
        if (method === 'Cash') {
            cashArea.style.display = 'block';
        } else {
            cashArea.style.display = 'none';
            document.getElementById('cashTendered').value = '';
            document.getElementById('changeDisplay').innerText = '0.00';
        }
    }

    function updateChange() {
        const netStr = document.getElementById('netTotalDisplay').innerText.replace(/,/g, '');
        const netTotal = parseFloat(netStr) || 0;
        const tendered = parseFloat(document.getElementById('cashTendered').value) || 0;
        const change = Math.max(0, tendered - netTotal);
        document.getElementById('changeDisplay').innerText = change.toFixed(2);
    }

    function setTenderedExact() {
        const netStr = document.getElementById('netTotalDisplay').innerText.replace(/,/g, '');
        document.getElementById('cashTendered').value = parseFloat(netStr) || 0;
        updateChange();
    }

    function addTendered(val) {
        const cur = parseFloat(document.getElementById('cashTendered').value) || 0;
        document.getElementById('cashTendered').value = cur + val;
        updateChange();
    }

    async function submitCheckout() {
        if (cart.length === 0) return;

        if (cart.some(i => i.rxRequired) && !(prescriptionId > 0)) {
            alert('This cart contains a prescription (Rx) medicine. Link the customer\'s prescription via the Prescriptions module, then use its "Dispense (POS)" button.');
            return;
        }

        const customerId = parseInt(document.getElementById('customerSelect').value, 10) || null;
        const payMethod = document.querySelector('input[name="payMethod"]:checked').value;
        const netStr = document.getElementById('netTotalDisplay').innerText.replace(/,/g, '');
        const netTotal = parseFloat(netStr) || 0;

        let cashTendered = parseFloat(document.getElementById('cashTendered').value) || 0;
        if (payMethod !== 'Cash') {
            cashTendered = netTotal;
        } else if (cashTendered < netTotal) {
            alert(`Cash tendered (₱${cashTendered.toFixed(2)}) is less than net payable (₱${netTotal.toFixed(2)}).`);
            return;
        }

const usePoints = document.getElementById('usePointsSwitch').checked;
        const availablePoints = parseInt(document.getElementById('customerSelect').options[document.getElementById('customerSelect').selectedIndex]?.dataset.points || '0', 10);
        const discountType = document.getElementById('discountTypeSelect').value;
        const discountIdNumber = document.getElementById('discountIdInput').value.trim();

        if (discountType !== 'None' && discountIdNumber.length === 0) {
            alert('Please enter the Senior Citizen / PWD ID number to apply the discount.');
            return;
        }

        const statDiscount = parseFloat(document.getElementById('statDiscountDisplay').innerText) || 0;
        const payableBeforePoints = Math.max(0, (cart.reduce((s, i) => s + (i.qty * i.price), 0)) - statDiscount);
        const pointsToRedeem = usePoints ? Math.min(availablePoints, Math.floor(payableBeforePoints)) : 0;

        const payload = {
            customerId: customerId,
            prescriptionId: prescriptionId > 0 ? prescriptionId : null,
            paymentMethod: payMethod,
            cashTendered: cashTendered,
            pointsToRedeem: pointsToRedeem,
            discountType: discountType,
            discountIdNumber: discountIdNumber,
            items: cart.map(i => ({ medicineId: i.medId, quantity: i.qty }))
        };

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        const btn = document.getElementById('btnCheckout');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing Sale...';

        try {
            const resp = await fetch('@Url.Action("Checkout", "Sales")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            });

            const data = await resp.json();
            if (data.success) {
                window.location.href = data.redirectUrl;
            } else {
                alert(data.message || 'Failed to complete checkout.');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Complete Checkout &amp; Receipt';
            }
        } catch (err) {
            console.error(err);
            alert('An unexpected error occurred during checkout.');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Complete Checkout &amp; Receipt';
        }
    }

    // Call onCustomerChange once on load to configure pre-selected customer
    document.addEventListener('DOMContentLoaded', () => {
        onCustomerChange();
        loadMeds();
    });
</script>
}
