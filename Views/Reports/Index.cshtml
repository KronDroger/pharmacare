@{
    ViewData["Title"] = "Executive Reports & Analytics";
    var salesByMonth = ViewBag.SalesByMonth as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var topMedicines = ViewBag.TopMedicines as List<CarePlusPharmacy.Controllers.ReportsController.TopSellerReportItem> ?? new();
    var topCustomers = ViewBag.TopCustomers as List<CarePlusPharmacy.Controllers.ReportsController.TopCustomerReportItem> ?? new();

    decimal totalRevenue = ViewBag.TotalRevenue ?? 0;
    decimal inventoryValue = ViewBag.InventoryValue ?? 0;
    decimal purchasingCost = ViewBag.TotalPurchasingCost ?? 0;
    decimal grossProfit = ViewBag.GrossProfit ?? 0;
    decimal expiredLoss = ViewBag.ExpiredLoss ?? 0;
    decimal nearExpiryRisk = ViewBag.NearExpiryRisk ?? 0;
    int pointsCirculating = ViewBag.PointsCirculating ?? 0;
    int totalTx = ViewBag.TotalTransactions ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <h4 class="fw-bold mb-0 text-dark" style="color: var(--cp-forest-deep);"><i class="bi bi-graph-up-arrow text-success me-2"></i>Executive ERP &amp; CRM Analytics</h4>
        <div class="text-muted" style="font-size: 13px;">Real-time business intelligence across sales, inventory valuation, purchasing, and patient CRM</div>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-careplus" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print / Export Report
        </button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            Dashboard
        </a>
    </div>
</div>

<!-- Financial KPI Summary Cards -->
<div class="d-flex flex-wrap gap-3 mb-4">
    <div class="stat-card">
        <div class="stat-icon icon-green">
            <i class="bi bi-currency-dollar"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Gross Revenue</div>
            <div class="stat-value text-success">₱@totalRevenue.ToString("N2")</div>
        </div>
        <div class="stat-footer">
            <span class="text-success fw-bold">+22%</span> vs last month
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-blue">
            <i class="bi bi-cash-coin"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Estimated Gross Profit</div>
            <div class="stat-value text-primary">₱@grossProfit.ToString("N2")</div>
        </div>
        <div class="stat-footer">
            <span class="text-primary fw-bold">Margin</span> after COGS
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-purple">
            <i class="bi bi-boxes"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Inventory Asset Value</div>
            <div class="stat-value text-dark">₱@inventoryValue.ToString("N2")</div>
        </div>
        <div class="stat-footer">
            <span class="text-purple fw-bold">Current</span> warehouse stock
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-red">
            <i class="bi bi-exclamation-octagon"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Expiry Spoilage Loss</div>
            <div class="stat-value text-danger">₱@expiredLoss.ToString("N2")</div>
        </div>
        <div class="stat-footer">
            <span class="text-danger fw-bold">-3%</span> near-expiry risk
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="table-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-bar-chart-line-fill text-success me-2"></i>Sales Revenue Monthly Trend</h6>
                    <div class="text-muted" style="font-size: 12px;">Monthly cash flow and POS volume</div>
                </div>
                <span class="badge bg-light text-muted border">YTD Trajectory</span>
            </div>
            <canvas id="revenueChart" height="220"></canvas>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="table-card p-4 h-100">
            <div class="mb-3">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-pie-chart-fill text-primary me-2"></i>ERP Financial Ratio</h6>
                <div class="text-muted" style="font-size: 12px;">Revenue vs Purchasing &amp; Losses</div>
            </div>
            <canvas id="financialDonut" height="220"></canvas>
        </div>
    </div>
</div>

<!-- Tables: Top Medicines & Top CRM Customers -->
<div class="row g-4">
    <div class="col-lg-6">
        <div class="table-card h-100">
            <div class="table-card-header">
                <div>
                    <div class="fw-bold fs-6 text-dark"><i class="bi bi-star-fill text-warning me-2"></i>Top-Selling Pharmaceutical Products</div>
                    <div class="text-muted" style="font-size: 12px;">Ranked by total sales revenue</div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Medicine</th>
                            <th>Category</th>
                            <th>Units Sold</th>
                            <th class="text-end">Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!topMedicines.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">No sales data recorded yet.</td></tr>
                        }
                        @foreach (var med in topMedicines)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@med.MedicineName</td>
                                <td><span class="badge bg-light text-muted border">@med.Category</span></td>
                                <td class="fw-semibold">@med.UnitsSold units</td>
                                <td class="text-end fw-bold text-success">₱@med.Revenue.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="table-card h-100">
            <div class="table-card-header">
                <div>
                    <div class="fw-bold fs-6 text-dark"><i class="bi bi-people-fill text-success me-2"></i>Top Patient CRM Accounts</div>
                    <div class="text-muted" style="font-size: 12px;">Top spending patients with loyalty engagement</div>
                </div>
                <a asp-controller="Crm" asp-action="Index" class="btn btn-sm btn-outline-careplus">CRM Hub</a>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Patient Name</th>
                            <th>Tier</th>
                            <th>Orders</th>
                            <th>Points</th>
                            <th class="text-end">Total Spent</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!topCustomers.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No customer sales recorded yet.</td></tr>
                        }
                        @foreach (var cust in topCustomers)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@cust.CustomerName</td>
                                <td>
                                    @if (cust.LoyaltyPoints >= 500)
                                    {
                                        <span class="badge-tier-platinum" style="font-size: 10px;">@cust.Tier</span>
                                    }
                                    else if (cust.LoyaltyPoints >= 250)
                                    {
                                        <span class="badge-tier-gold" style="font-size: 10px;">@cust.Tier</span>
                                    }
                                    else
                                    {
                                        <span class="badge-tier-silver" style="font-size: 10px;">@cust.Tier</span>
                                    }
                                </td>
                                <td>@cust.OrdersCount order(s)</td>
                                <td class="fw-bold text-success">@cust.LoyaltyPoints pts</td>
                                <td class="text-end fw-bold text-dark">₱@cust.TotalSpent.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const ctx = document.getElementById('revenueChart');
        if (ctx) {
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(Json.Serialize(salesByMonth.Select(x => x.Month))),
                    datasets: [{
                        label: 'Gross Sales Revenue (₱)',
                        data: @Html.Raw(Json.Serialize(salesByMonth.Select(x => x.Total))),
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.15)',
                        borderWidth: 3,
                        pointBackgroundColor: '#10b981',
                        pointRadius: 5,
                        tension: 0.35,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#f0f4f2' } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        const donutCtx = document.getElementById('financialDonut');
        if (donutCtx) {
            new Chart(donutCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Sales Revenue', 'Inventory Asset Value', 'Purchasing Cost'],
                    datasets: [{
                        data: [@totalRevenue, @inventoryValue, @purchasingCost],
                        backgroundColor: ['#10b981', '#0e3d32', '#3b82f6'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
                    }
                }
            });
        }
    </script>
}
