@inject CarePlusPharmacy.Data.ApplicationDbContext DbContext
@inject CarePlusPharmacy.Services.ICurrentCustomerService CurrCustomerService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CarePlus Pharmacy ERP & CRM</title>
    <link rel="icon" type="image/svg+xml" href="~/images/careplus-icon.svg" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function () {
            try {
                if (localStorage.getItem('careplus_sidebar_collapsed') === 'true') {
                    document.documentElement.classList.add('sidebar-pre-collapsed');
                }
                if (localStorage.getItem('careplus_theme') === 'dark') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                }
            } catch (e) { }
        })();
    </script>
</head>
<body>
@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString();

    // Query quick counts for alert badges
    int nearExpiryCount = 0;
    int lowStockCount = 0;
    CarePlusPharmacy.Models.Customer? portalCustomer = null;
    int activeSubCount = 0;
    try
    {
        var now = DateTime.Today;
        var warnDate = now.AddDays(90);
        nearExpiryCount = DbContext.MedicineBatches.Count(b => b.ExpiryDate <= warnDate && b.Quantity > 0);
        lowStockCount = DbContext.Medicines.Count(m => m.Batches.Sum(b => b.Quantity) <= m.ReorderLevel);

        if (User.IsInRole("Customer"))
        {
            portalCustomer = await CurrCustomerService.GetCurrentCustomerAsync(User);
            if (portalCustomer != null)
            {
                activeSubCount = DbContext.CustomerSubscriptions.Count(s =>
                    s.CustomerId == portalCustomer.Id && s.Status == CarePlusPharmacy.Models.SubscriptionStatus.Active);
            }
        }
    }
    catch { }

    <div class="app-shell" id="appShell">
        <!-- Sidebar -->
        <aside class="sidebar" id="mainSidebar">
            <div class="sidebar-brand-wrapper">
                <a class="brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/careplus-icon.svg" alt="CarePlus" class="brand-logo-img" />
                    <div class="brand-text">
                        <span class="brand-name">CarePlus</span>
                        <span class="brand-sub">PHARMACY</span>
                    </div>
                </a>
                <button type="button" class="sidebar-burger-btn" id="sidebarToggle" title="Collapse sidebar" aria-label="Toggle sidebar">
                    <i class="bi bi-list"></i>
                </button>
            </div>

            @{
                // Each sidebar section header renders only when at least one of its
                // links is visible to the current user's role.
                var showCoreOps = User.IsInRole("Admin") || User.IsInRole("Cashier") || User.IsInRole("Pharmacist");
                var showInventory = User.IsInRole("Admin") || User.IsInRole("InventoryCoordinator") || User.IsInRole("Pharmacist");
                var showCrm = User.IsInRole("Admin") || User.IsInRole("Cashier") || User.IsInRole("Pharmacist");
                var showCompliance = User.IsInRole("Admin") || User.IsInRole("Pharmacist");
            }

            <nav class="nav flex-column">
                @if (!User.IsInRole("Customer"))
                {
                    <a class="nav-link @(currentCtrl == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Dashboard">
                        <i class="bi bi-grid-1x2-fill"></i> <span class="nav-text">Dashboard</span>
                    </a>
                }
                @if (!User.IsInRole("Customer"))
                {
                    <a class="nav-link @(currentCtrl == "Branches" ? "active" : "")" asp-controller="Branches" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Branches">
                        <i class="bi bi-geo-alt-fill"></i> <span class="nav-text">Branches</span>
                    </a>
                }

                <!-- SECTION: OPERATIONS -->
                @if (showCoreOps)
                {
                    <div class="sidebar-section-title">Core Operations</div>

                    <a class="nav-link @(currentCtrl == "Sales" ? "active" : "")" asp-controller="Sales" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Sales &amp; POS">
                        <i class="bi bi-cart3"></i> <span class="nav-text">Sales &amp; POS</span>
                    </a>

                    @if (User.IsInRole("Admin") || User.IsInRole("Cashier"))
                    {
                        <a class="nav-link @(currentCtrl == "Billing" ? "active" : "")" asp-controller="Billing" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Billing &amp; Invoices">
                            <i class="bi bi-receipt"></i> <span class="nav-text">Billing &amp; Invoices</span>
                        </a>
                    }

                    @if (User.IsInRole("Admin") || User.IsInRole("Pharmacist"))
                    {
                        <a class="nav-link @(currentCtrl == "Prescriptions" ? "active" : "")" asp-controller="Prescriptions" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Prescriptions">
                            <i class="bi bi-file-earmark-medical"></i> <span class="nav-text">Prescriptions</span>
                        </a>
                    }
                }

                <!-- SECTION: INVENTORY & ERP -->
                @if (showInventory)
                {
                    <div class="sidebar-section-title">Inventory &amp; ERP</div>

                    <a class="nav-link @(currentCtrl == "Medicines" && currentAct != "Expiring" ? "active" : "")" asp-controller="Medicines" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Medicine Stock@(lowStockCount > 0 ? $" ({lowStockCount} low)" : "")">
                        <i class="bi bi-capsule-pill"></i>
                        <span class="nav-text">Medicine Stock</span>
                        @if (lowStockCount > 0)
                        {
                            <span class="badge bg-warning text-dark nav-badge">@lowStockCount low</span>
                        }
                    </a>
                    <a class="nav-link @(currentCtrl == "Medicines" && currentAct == "Expiring" ? "active" : "")" asp-controller="Medicines" asp-action="Expiring" data-bs-toggle="tooltip" data-bs-placement="right" title="Expiry Monitor@(nearExpiryCount > 0 ? $" ({nearExpiryCount})" : "")">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span class="nav-text">Expiry Monitor</span>
                        @if (nearExpiryCount > 0)
                        {
                            <span class="badge bg-danger nav-badge">@nearExpiryCount</span>
                        }
                    </a>

                    @if (User.IsInRole("Admin") || User.IsInRole("InventoryCoordinator"))
                    {
                        <a class="nav-link @(currentCtrl == "Suppliers" ? "active" : "")" asp-controller="Suppliers" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Suppliers">
                            <i class="bi bi-truck"></i> <span class="nav-text">Suppliers</span>
                        </a>
                        <a class="nav-link @(currentCtrl == "PurchaseOrders" ? "active" : "")" asp-controller="PurchaseOrders" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Purchasing (PO)">
                            <i class="bi bi-clipboard-check"></i> <span class="nav-text">Purchasing (PO)</span>
                        </a>
                    }
                }

                <!-- SECTION: MY ACCOUNT (Customer Portal) -->
                @if (User.IsInRole("Customer"))
                {
                    <div class="sidebar-patient-card">
                        <div class="patient-avatar">
                            @(portalCustomer != null ? portalCustomer.FullName.Substring(0, 1).ToUpper() : (User.Identity!.Name?.Substring(0, 1).ToUpper() ?? "U"))
                        </div>
                        <div class="ms-2" style="min-width: 0;">
                            <div class="patient-name text-truncate">@(portalCustomer?.FullName ?? User.Identity.Name)</div>
                            <div class="patient-meta">
                                @if (portalCustomer != null)
                                {
                                    @portalCustomer.Tier <span>·</span> <span class="text-warning">@portalCustomer.LoyaltyPoints pts</span>
                                }
                                else
                                {
                                    <span class="fst-italic">Not linked yet</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="sidebar-section-title">My Account</div>

                    <a class="nav-link @(currentCtrl == "Portal" && currentAct == "Index" ? "active" : "")" asp-controller="Portal" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="My Dashboard">
                        <i class="bi bi-speedometer2"></i> <span class="nav-text">My Dashboard</span>
                    </a>
                    <a class="nav-link @(currentCtrl == "Portal" && currentAct == "Profile" ? "active" : "")" asp-controller="Portal" asp-action="Profile" data-bs-toggle="tooltip" data-bs-placement="right" title="My Profile">
                        <i class="bi bi-person-vcard"></i> <span class="nav-text">My Profile</span>
                    </a>
                    <a class="nav-link @(currentCtrl == "Portal" && currentAct == "Purchases" ? "active" : "")" asp-controller="Portal" asp-action="Purchases" data-bs-toggle="tooltip" data-bs-placement="right" title="My Purchases">
                        <i class="bi bi-bag-check"></i> <span class="nav-text">My Purchases</span>
                    </a>
                    <a class="nav-link @(currentCtrl == "Portal" && currentAct == "Prescriptions" ? "active" : "")" asp-controller="Portal" asp-action="Prescriptions" data-bs-toggle="tooltip" data-bs-placement="right" title="My Prescriptions">
                        <i class="bi bi-file-earmark-medical"></i> <span class="nav-text">My Prescriptions</span>
                    </a>
                    <a class="nav-link @(currentCtrl == "Portal" && currentAct == "Rewards" ? "active" : "")" asp-controller="Portal" asp-action="Rewards" data-bs-toggle="tooltip" data-bs-placement="right" title="My Rewards &amp; Points">
                        <i class="bi bi-gift"></i> <span class="nav-text">My Rewards</span>
                    </a>
                    <a class="nav-link @(currentCtrl == "Portal" && currentAct == "Subscriptions" ? "active" : "")" asp-controller="Portal" asp-action="Subscriptions" data-bs-toggle="tooltip" data-bs-placement="right" title="My Subscriptions">
                        <i class="bi bi-arrow-repeat"></i>
                        <span class="nav-text">My Subscriptions</span>
                        @if (activeSubCount > 0)
                        {
                            <span class="badge nav-badge" style="background-color: var(--cp-success); color: #ffffff;">@activeSubCount active</span>
                        }
                    </a>
                    <a class="nav-link @(currentCtrl == "Subscriptions" && currentAct == "Browse" ? "active" : "")" asp-controller="Subscriptions" asp-action="Browse" data-bs-toggle="tooltip" data-bs-placement="right" title="Browse Refill Plans">
                        <i class="bi bi-shop"></i> <span class="nav-text">Browse Refill Plans</span>
                    </a>
                    <a class="nav-link @(currentCtrl == "Branches" ? "active" : "")" asp-controller="Branches" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Branches">
                        <i class="bi bi-geo-alt-fill"></i> <span class="nav-text">Branches</span>
                    </a>
                }

                <!-- SECTION: CRM & HEALTHCARE -->
                @if (showCrm)
                {
                    <div class="sidebar-section-title">CRM &amp; Patients</div>

                    @if (User.IsInRole("Admin") || User.IsInRole("Cashier") || User.IsInRole("Pharmacist"))
                    {
                        <a class="nav-link @(currentCtrl == "Crm" ? "active" : "")" asp-controller="Crm" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Customer CRM">
                            <i class="bi bi-heart-pulse-fill"></i> <span class="nav-text">Customer CRM</span>
                        </a>
                        <a class="nav-link @(currentCtrl == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Customers Directory">
                            <i class="bi bi-people-fill"></i> <span class="nav-text">Customers Directory</span>
                        </a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="nav-link @(currentCtrl == "Subscriptions" && currentAct == "Plans" ? "active" : "")" asp-controller="Subscriptions" asp-action="Plans" data-bs-toggle="tooltip" data-bs-placement="right" title="Subscription Plans">
                            <i class="bi bi-arrow-repeat"></i> <span class="nav-text">Subscription Plans</span>
                        </a>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("Cashier"))
                    {
                        <a class="nav-link @(currentCtrl == "Subscriptions" && currentAct == "DueRefills" ? "active" : "")" asp-controller="Subscriptions" asp-action="DueRefills" data-bs-toggle="tooltip" data-bs-placement="right" title="Due Refills">
                            <i class="bi bi-clock-history"></i> <span class="nav-text">Due Refills</span>
                        </a>
                    }
                }

                <!-- SECTION: ADMINISTRATION -->
                @if (showCompliance)
                {
                    <div class="sidebar-section-title">Compliance &amp; Admin</div>

                    <a class="nav-link @(currentCtrl == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Reports &amp; Analytics">
                        <i class="bi bi-bar-chart-fill"></i> <span class="nav-text">Reports &amp; Analytics</span>
                    </a>
                    <a class="nav-link @(currentCtrl == "AuditLogs" ? "active" : "")" asp-controller="AuditLogs" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Audit Trails &amp; Logs">
                        <i class="bi bi-shield-check"></i> <span class="nav-text">Audit Trails &amp; Logs</span>
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="nav-link @(currentCtrl == "UserManagement" ? "active" : "")" asp-controller="UserManagement" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Staff Roles &amp; RBAC">
                            <i class="bi bi-person-gear"></i> <span class="nav-text">Staff Roles &amp; RBAC</span>
                        </a>
                    }
                }
            </nav>
        </aside>

        <!-- Main Column -->
        <div class="main-column">
            <header class="topbar">
                <div class="d-flex align-items-center">
                    <button type="button" class="topbar-burger-btn" id="topbarSidebarToggle" title="Toggle sidebar" aria-label="Toggle sidebar">
                        <i class="bi bi-list"></i>
                    </button>
                    <div>
                        <h1 class="page-title">@ViewData["Title"]</h1>
                        <div class="page-sub"> </div>
                    </div>
                </div>

                <div class="topbar-actions">
                    @if (User.IsInRole("Admin") || User.IsInRole("Cashier"))
                    {
                        <a asp-controller="Sales" asp-action="Create" class="btn btn-sm btn-accent d-none d-md-inline-flex align-items-center gap-1">
                            <i class="bi bi-cart-plus"></i> New POS Sale
                        </a>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("Pharmacist"))
                    {
                        <a asp-controller="Prescriptions" asp-action="Create" class="btn btn-sm btn-outline-careplus d-none d-lg-inline-flex align-items-center gap-1">
                            <i class="bi bi-plus-circle"></i> New Prescription
                        </a>
                    }

                    <!-- Theme Toggle -->
                    <button type="button" id="themeToggle" class="btn btn-sm btn-outline-secondary" title="Toggle light / dark mode" aria-label="Toggle light / dark mode">
                        <i class="bi bi-moon-stars" id="themeIcon"></i>
                    </button>

                    <!-- User Pill -->
                    <div class="user-profile-badge">
                        <div class="user-avatar">
                            @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                        <div>
                            <div class="user-meta-name">@User.Identity.Name</div>
                            <div class="user-meta-role">
                                @if (User.IsInRole("Admin")) { <span>Main Admin</span> }
                                else if (User.IsInRole("Pharmacist")) { <span>Pharmacist</span> }
                                else if (User.IsInRole("Cashier")) { <span>Cashier / POS</span> }
                                else if (User.IsInRole("InventoryCoordinator")) { <span>Inventory Coord.</span> }
                                else { <span>Customer</span> }
                            </div>
                        </div>
                    </div>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Sign out">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </header>

            <main class="page-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                        <div>@TempData["Success"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                        <div>@TempData["Error"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <main class="auth-page">
        @RenderBody()
    </main>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Theme-aware Chart.js helper so dashboard graphs react to light/dark mode.
    function appChartTheme(dark) {
        var charts = window.careplusCharts || [];
        charts.forEach(function (chart) {
            try {
                if (chart.options.scales) {
                    Object.values(chart.options.scales).forEach(function (ax) {
                        if (ax.grid) ax.grid.color = dark ? '#2a3a32' : '#f0f3f1';
                        if (ax.ticks) ax.ticks.color = dark ? '#9cb3a9' : '#647a71';
                    });
                }
                if (chart.options.plugins && chart.options.plugins.legend && chart.options.plugins.legend.labels) {
                    chart.options.plugins.legend.labels.color = dark ? '#c9d8d2' : '#5b6b64';
                }
                if (chart.config.type === 'doughnut' && chart.data.datasets[0]) {
                    chart.data.datasets[0].borderColor = dark ? '#121d18' : '#ffffff';
                }
                chart.update();
            } catch (e) { }
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        const appShell = document.getElementById('appShell');
        if (!appShell) return;

        const sidebarToggle = document.getElementById('sidebarToggle');
        const topbarSidebarToggle = document.getElementById('topbarSidebarToggle');

        // Theme (light / dark) handling
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');

        function currentTheme() {
            return document.documentElement.getAttribute('data-theme') || 'light';
        }

        function syncThemeUi(dark) {
            if (themeIcon) themeIcon.className = dark ? 'bi bi-sun' : 'bi bi-moon-stars';
            if (dark) {
                appShell.setAttribute('data-bs-theme', 'dark');
            } else {
                appShell.removeAttribute('data-bs-theme');
            }
            appChartTheme(dark);
        }

        if (themeToggle) {
            themeToggle.addEventListener('click', function () {
                const next = currentTheme() === 'dark' ? 'light' : 'dark';
                try {
                    localStorage.setItem('careplus_theme', next);
                } catch (e) { }
                if (next === 'dark') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                } else {
                    document.documentElement.removeAttribute('data-theme');
                }
                syncThemeUi(next === 'dark');
            });
        }

        syncThemeUi(currentTheme() === 'dark');

        // Tooltip instances
        const tooltipElements = Array.from(document.querySelectorAll('.sidebar [data-bs-toggle="tooltip"]'));
        const tooltipInstances = tooltipElements.map(function (el) {
            return new bootstrap.Tooltip(el, {
                customClass: 'sidebar-tooltip',
                trigger: 'hover',
                boundary: 'clippingParents'
            });
        });

        function setSidebarState(collapsed) {
            if (collapsed) {
                appShell.classList.add('sidebar-collapsed');
                localStorage.setItem('careplus_sidebar_collapsed', 'true');
                if (sidebarToggle) {
                    sidebarToggle.setAttribute('title', 'Expand sidebar');
                }
                tooltipInstances.forEach(function (t) { t.enable(); });
            } else {
                appShell.classList.remove('sidebar-collapsed');
                localStorage.setItem('careplus_sidebar_collapsed', 'false');
                if (sidebarToggle) {
                    sidebarToggle.setAttribute('title', 'Collapse sidebar');
                }
                tooltipInstances.forEach(function (t) {
                    t.disable();
                    t.hide();
                });
            }
        }

        // Initialize state from localStorage
        const isCollapsed = localStorage.getItem('careplus_sidebar_collapsed') === 'true';
        setSidebarState(isCollapsed);

        // Remove anti-flicker class
        document.documentElement.classList.remove('sidebar-pre-collapsed');

        function toggle() {
            const currentlyCollapsed = appShell.classList.contains('sidebar-collapsed');
            setSidebarState(!currentlyCollapsed);
        }

        if (sidebarToggle) sidebarToggle.addEventListener('click', toggle);
        if (topbarSidebarToggle) topbarSidebarToggle.addEventListener('click', toggle);
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
