@inject CarePlusPharmacy.Data.ApplicationDbContext DbContext
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CarePlus Pharmacy ERP & CRM</title>
    <link rel="icon" type="image/svg+xml" href="~/images/careplus-icon.svg" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString();

    // Query quick counts for alert badges
    int nearExpiryCount = 0;
    int lowStockCount = 0;
    try
    {
        var now = DateTime.Today;
        var warnDate = now.AddDays(90);
        nearExpiryCount = DbContext.MedicineBatches.Count(b => b.ExpiryDate <= warnDate && b.Quantity > 0);
        lowStockCount = DbContext.Medicines.Count(m => m.Batches.Sum(b => b.Quantity) <= m.ReorderLevel);
    }
    catch { }

    <div class="app-shell">
        <!-- Sidebar -->
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/careplus-icon.svg" alt="CarePlus" style="width: 40px; height: 40px;" />
                <div class="brand-text">
                    <span class="brand-name">CarePlus</span>
                    <span class="brand-sub">PHARMACY</span>
                </div>
            </a>

            <nav class="nav flex-column">
                <a class="nav-link @(currentCtrl == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill"></i> Dashboard
                </a>

                <!-- SECTION: OPERATIONS -->
                <div class="sidebar-section-title">Core Operations</div>

                @if (User.IsInRole("Admin") || User.IsInRole("Cashier") || User.IsInRole("Pharmacist"))
                {
                    <a class="nav-link @(currentCtrl == "Sales" ? "active" : "")" asp-controller="Sales" asp-action="Index">
                        <i class="bi bi-cart3"></i> Sales &amp; POS
                    </a>
                    <a class="nav-link @(currentCtrl == "Billing" ? "active" : "")" asp-controller="Billing" asp-action="Index">
                        <i class="bi bi-receipt"></i> Billing &amp; Invoices
                    </a>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("Pharmacist"))
                {
                    <a class="nav-link @(currentCtrl == "Prescriptions" ? "active" : "")" asp-controller="Prescriptions" asp-action="Index">
                        <i class="bi bi-file-earmark-medical"></i> Prescriptions
                    </a>
                }

                <!-- SECTION: INVENTORY & ERP -->
                <div class="sidebar-section-title">Inventory &amp; ERP</div>

                @if (User.IsInRole("Admin") || User.IsInRole("InventoryCoordinator") || User.IsInRole("Pharmacist"))
                {
                    <a class="nav-link @(currentCtrl == "Medicines" && currentAct != "Expiring" ? "active" : "")" asp-controller="Medicines" asp-action="Index">
                        <i class="bi bi-capsule-pill"></i> Medicine Stock
                        @if (lowStockCount > 0)
                        {
                            <span class="badge bg-warning text-dark nav-badge">@lowStockCount low</span>
                        }
                    </a>
                    <a class="nav-link @(currentCtrl == "Medicines" && currentAct == "Expiring" ? "active" : "")" asp-controller="Medicines" asp-action="Expiring">
                        <i class="bi bi-exclamation-triangle-fill"></i> Expiry Monitor
                        @if (nearExpiryCount > 0)
                        {
                            <span class="badge bg-danger nav-badge">@nearExpiryCount</span>
                        }
                    </a>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("InventoryCoordinator"))
                {
                    <a class="nav-link @(currentCtrl == "Suppliers" ? "active" : "")" asp-controller="Suppliers" asp-action="Index">
                        <i class="bi bi-truck"></i> Suppliers
                    </a>
                    <a class="nav-link @(currentCtrl == "PurchaseOrders" ? "active" : "")" asp-controller="PurchaseOrders" asp-action="Index">
                        <i class="bi bi-clipboard-check"></i> Purchasing (PO)
                    </a>
                }

                <!-- SECTION: CRM & HEALTHCARE -->
                <div class="sidebar-section-title">CRM &amp; Patients</div>

                @if (User.IsInRole("Admin") || User.IsInRole("Cashier") || User.IsInRole("Pharmacist"))
                {
                    <a class="nav-link @(currentCtrl == "Crm" ? "active" : "")" asp-controller="Crm" asp-action="Index">
                        <i class="bi bi-heart-pulse-fill"></i> Customer CRM
                    </a>
                    <a class="nav-link @(currentCtrl == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index">
                        <i class="bi bi-people-fill"></i> Customers Directory
                    </a>
                }
                else if (User.IsInRole("Customer"))
                {
                    <a class="nav-link @(currentCtrl == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index">
                        <i class="bi bi-person-circle"></i> My Account &amp; Rx
                    </a>
                }

                <!-- SECTION: ADMINISTRATION -->
                @if (User.IsInRole("Admin") || User.IsInRole("Pharmacist"))
                {
                    <div class="sidebar-section-title">Compliance &amp; Admin</div>
                    <a class="nav-link @(currentCtrl == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">
                        <i class="bi bi-bar-chart-fill"></i> Reports &amp; Analytics
                    </a>
                    <a class="nav-link @(currentCtrl == "AuditLogs" ? "active" : "")" asp-controller="AuditLogs" asp-action="Index">
                        <i class="bi bi-shield-check"></i> Audit Trails &amp; Logs
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="nav-link @(currentCtrl == "UserManagement" ? "active" : "")" asp-controller="UserManagement" asp-action="Index">
                            <i class="bi bi-person-gear"></i> Staff Roles &amp; RBAC
                        </a>
                    }
                }
            </nav>
        </aside>

        <!-- Main Column -->
        <div class="main-column">
            <header class="topbar">
                <div>
                    <h1 class="page-title">@ViewData["Title"]</h1>
                    <div class="page-sub"> </div>
                </div>

                <div class="topbar-actions">
                    @if (User.IsInRole("Admin") || User.IsInRole("Cashier"))
                    {
                        <a asp-controller="Sales" asp-action="Create" class="btn btn-sm btn-accent d-none d-md-inline-flex align-items-center gap-1">
                            <i class="bi bi-cart-plus"></i> New POS Sale
                        </a>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("Pharmacist"))
                    {
                        <a asp-controller="Prescriptions" asp-action="Create" class="btn btn-sm btn-outline-careplus d-none d-lg-inline-flex align-items-center gap-1">
                            <i class="bi bi-plus-circle"></i> New Prescription
                        </a>
                    }

                    <!-- User Pill -->
                    <div class="user-profile-badge">
                        <div class="user-avatar">
                            @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                        <div>
                            <div class="user-meta-name">@User.Identity.Name</div>
                            <div class="user-meta-role">
                                @if (User.IsInRole("Admin")) { <span>Main Admin</span> }
                                else if (User.IsInRole("Pharmacist")) { <span>Pharmacist</span> }
                                else if (User.IsInRole("Cashier")) { <span>Cashier / POS</span> }
                                else if (User.IsInRole("InventoryCoordinator")) { <span>Inventory Coord.</span> }
                                else { <span>Customer</span> }
                            </div>
                        </div>
                    </div>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Sign out">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </header>

            <main class="page-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                        <div>@TempData["Success"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                        <div>@TempData["Error"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <main class="auth-page">
        @RenderBody()
    </main>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
