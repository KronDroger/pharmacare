@model List<CarePlusPharmacy.Models.Customer>
@{
    ViewData["Title"] = "Customer CRM & Loyalty Program";
    var refillAlerts = ViewBag.RefillAlerts as List<CarePlusPharmacy.Controllers.CrmController.RefillAlertViewModel> ?? new();
    var recommendations = ViewBag.Recommendations as List<CarePlusPharmacy.Controllers.CrmController.ProductRecommendationViewModel> ?? new();
    int totalPoints = ViewBag.TotalPointsOutstanding ?? 0;
    int totalCustomers = ViewBag.TotalCustomers ?? 0;
    int vipCount = ViewBag.VipCount ?? 0;
}

<!-- CRM Header Banner -->
<div class="card border-0 mb-4 shadow-sm" style="background: linear-gradient(135deg, #0b382e 0%, #165647 100%); border-radius: var(--radius-lg);">
    <div class="card-body p-4 text-white">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="mb-1 fw-bold" style="color: #6ee7b7; font-size: 13px;">
                    <i class="bi bi-heart-pulse-fill me-1"></i> Patient Relationship Management
                </div>
                <h3 class="fw-bold mb-1">Patient Engagement &amp; Loyalty Hub</h3>
                <p class="text-white-50 mb-0" style="font-size: 13.5px;">Track customer loyalty points, manage VIP tiers, automate chronic medication refill reminders, and maintain expiry-safe product recommendations.</p>
            </div>
            <div class="col-lg-4 text-lg-end text-center mt-3 mt-lg-0">
                <a asp-controller="Customers" asp-action="Create" class="btn btn-accent me-2">
                    <i class="bi bi-person-plus-fill me-1"></i> Add Patient
                </a>
                <a asp-controller="Sales" asp-action="Create" class="btn btn-outline-light">
                    <i class="bi bi-cart3 me-1"></i> POS Checkout
                </a>
            </div>
        </div>
    </div>
</div>

<!-- CRM KPI Metrics -->
<div class="d-flex flex-wrap gap-3 mb-4">
    <div class="stat-card">
        <div class="stat-icon icon-blue">
            <i class="bi bi-people-fill"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Registered Patients</div>
            <div class="stat-value">@totalCustomers</div>
        </div>
        <div class="stat-footer">
            <span class="text-success fw-bold">+3%</span> vs last month
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-amber">
            <i class="bi bi-stars"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Loyalty Points Circulating</div>
            <div class="stat-value text-warning">@totalPoints.ToString("N0") <span style="font-size: 13px; font-weight: 500; color: #7b809a;">pts</span></div>
        </div>
        <div class="stat-footer">
            <span class="text-warning fw-bold">Active</span> reward pool
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-purple">
            <i class="bi bi-award-fill"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">VIP &amp; Gold Members</div>
            <div class="stat-value" style="color: #8e24aa;">@vipCount</div>
        </div>
        <div class="stat-footer">
            <span class="text-purple fw-bold">High</span> lifetime value
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-red">
            <i class="bi bi-alarm-fill"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Refill Alerts Active</div>
            <div class="stat-value text-danger">@refillAlerts.Count <span style="font-size: 13px; font-weight: 500; color: #e53935;">patients</span></div>
        </div>
        <div class="stat-footer">
            <span class="text-danger fw-bold"><i class="bi bi-bell-fill"></i> Maintenance</span> refills
        </div>
    </div>
</div>

<!-- Chronic Medication Refill Alerts Section -->
<div class="table-card mb-4">
    <div class="table-card-header">
        <div>
            <div class="fw-bold fs-6 text-danger"><i class="bi bi-bell-fill text-danger me-2"></i>Chronic Maintenance Refill Reminders</div>
            <div class="text-muted" style="font-size: 12px;">Patients with maintenance prescriptions (Hypertension, Diabetes, Cholesterol) due for resupply</div>
        </div>
        <span class="badge bg-danger">@refillAlerts.Count Alert(s)</span>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Patient Name</th>
                    <th>Contact Phone</th>
                    <th>Prescribed Medicine</th>
                    <th>Category</th>
                    <th>Last Dispensed</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!refillAlerts.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="bi bi-check-circle fs-3 text-success d-block mb-1"></i>
                            All chronic patient medication schedules are currently up-to-date.
                        </td>
                    </tr>
                }
                @foreach (var alert in refillAlerts)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-dark">@alert.CustomerName</div>
                            <span class="badge bg-light text-muted border">ID #@alert.CustomerId</span>
                        </td>
                        <td>
                            <a href="tel:@alert.Phone" class="text-decoration-none text-dark">
                                <i class="bi bi-telephone text-success me-1"></i>@alert.Phone
                            </a>
                        </td>
                        <td>
                            <span class="fw-semibold text-primary">@alert.MedicineName</span>
                            <div class="text-muted" style="font-size: 11.5px;">@alert.QuantityDispensed units dispensed</div>
                        </td>
                        <td><span class="badge bg-light text-muted border">@alert.Category</span></td>
                        <td>@alert.LastDispensedDate.ToString("yyyy-MM-dd") (@alert.DaysElapsed days ago)</td>
                        <td>
                            @if (alert.EstimatedDaysRemaining <= 3)
                            {
                                <span class="badge bg-danger">@alert.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@alert.Status</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="SendRefillReminder" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="customerId" value="@alert.CustomerId" />
                                <input type="hidden" name="medicineName" value="@alert.MedicineName" />
                                <button type="submit" class="btn btn-sm btn-outline-danger me-1">
                                    <i class="bi bi-send me-1"></i> Send Alert
                                </button>
                            </form>
                            <a asp-controller="Sales" asp-action="Create" class="btn btn-sm btn-accent">
                                <i class="bi bi-cart3"></i> Dispense Refill
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Expiry-Safe Product Recommendations -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: var(--radius-lg); border: 1px solid var(--cp-border);">
    <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center">
        <div>
            <div class="fw-bold fs-6" style="color: var(--cp-forest-deep);"><i class="bi bi-shield-check text-success me-2"></i>Expiry-Safe Product Recommendations</div>
            <div class="text-muted" style="font-size: 12px;">Verified pharmaceutical batches with ample shelf-life optimal for long-term patient regimens</div>
        </div>
        <span class="badge bg-success-subtle text-success border border-success-subtle">Quality Assured</span>
    </div>
    <div class="card-body p-3">
        <div class="row g-3">
            @foreach (var rec in recommendations)
            {
                <div class="col-md-4">
                    <div class="p-3 rounded h-100 d-flex flex-column justify-content-between" style="background: #fbfdfc; border: 1px solid var(--cp-border);">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-light text-muted border" style="font-size: 11px;">@rec.Category</span>
                                <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 10px;">
                                    <i class="bi bi-check2 me-1"></i>Expiry-Safe
                                </span>
                            </div>
                            <h6 class="fw-bold text-dark mt-2 mb-1">@rec.RecommendedMedicine</h6>
                            <div class="text-muted mb-2" style="font-size: 12px;"><i class="bi bi-capsule me-1"></i>@rec.GenericName</div>
                            <p class="text-muted" style="font-size: 12px; line-height: 1.4;">@rec.Rationale</p>
                        </div>
                        <div class="border-top pt-2 mt-2 d-flex justify-content-between align-items-center" style="font-size: 12px;">
                            <span>Stock: <strong>@rec.CurrentStock units</strong></span>
                            <span class="text-muted">Exp: @(rec.NearestExpiry?.ToString("MMM yyyy") ?? "Valid")</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Customer Directory & Loyalty Points Ledger -->
<div class="table-card">
    <div class="table-card-header">
        <div>
            <div class="fw-bold fs-6" style="color: var(--cp-forest-deep);"><i class="bi bi-trophy text-warning me-2"></i>Patient CRM Directory &amp; Loyalty Ledger</div>
            <div class="text-muted" style="font-size: 12px;">1 point earned per ₱100 spent · 1 point redeemed = ₱1.00 checkout discount</div>
        </div>
        <a asp-controller="Customers" asp-action="Create" class="btn btn-sm btn-careplus">
            <i class="bi bi-person-plus me-1"></i> Register New Patient
        </a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Patient / Customer</th>
                    <th>CRM Tier</th>
                    <th>Loyalty Points</th>
                    <th>Purchase History</th>
                    <th>Registered</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-dark">@c.FullName</div>
                            <div class="text-muted" style="font-size: 11.5px;">
                                <i class="bi bi-telephone me-1"></i>@c.Phone
                                @if (!string.IsNullOrEmpty(c.Email))
                                {
                                    <span class="ms-2"><i class="bi bi-envelope me-1"></i>@c.Email</span>
                                }
                            </div>
                        </td>
                        <td>
                            @if (c.LoyaltyPoints >= 500)
                            {
                                <span class="badge-tier-platinum">👑 @c.Tier</span>
                            }
                            else if (c.LoyaltyPoints >= 250)
                            {
                                <span class="badge-tier-gold">⭐ @c.Tier</span>
                            }
                            else if (c.LoyaltyPoints >= 100)
                            {
                                <span class="badge-tier-silver">🛡️ @c.Tier</span>
                            }
                            else
                            {
                                <span class="badge-tier-bronze">🏷️ @c.Tier</span>
                            }
                        </td>
                        <td>
                            <div class="fw-bold fs-6 text-success">@c.LoyaltyPoints.ToString("N0") <span style="font-size: 12px; font-weight: 500;">pts</span></div>
                            <div class="text-muted" style="font-size: 11px;">Value: ₱@c.LoyaltyPoints.ToString("N2") discount</div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@c.Sales.Count order(s)</span>
                            <div class="text-muted" style="font-size: 11px;">
                                Spent: ₱@(c.Sales.Sum(s => s.TotalAmount).ToString("N2"))
                            </div>
                        </td>
                        <td>@c.DateRegistered.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-warning py-1 px-2" style="font-size: 12px;" 
                                    onclick="openAwardModal(@c.Id, '@c.FullName.Replace("'", "\\'")')">
                                <i class="bi bi-gift me-1"></i> Award Points
                            </button>
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size: 12px;">
                                <i class="bi bi-eye"></i> Profile
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Award Bonus Points Modal -->
<div class="modal fade" id="awardPointsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: var(--radius-lg);">
            <form asp-action="AwardPoints" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" style="color: var(--cp-forest-deep);"><i class="bi bi-gift text-warning me-2"></i>Award CRM Bonus Points</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" id="modalCustomerId" name="customerId" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size: 13px;">Patient / Customer</label>
                        <input type="text" id="modalCustomerName" class="form-control bg-light" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size: 13px;">Points to Award</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-star-fill text-warning"></i></span>
                            <input type="number" name="points" class="form-control" placeholder="e.g. 50" min="1" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size: 13px;">Reason / Campaign</label>
                        <input type="text" name="reason" class="form-control" placeholder="e.g. Senior Citizen Promo, Holiday Bonus, Loyalty Milestone" required />
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-careplus">Confirm Award</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openAwardModal(id, name) {
        document.getElementById('modalCustomerId').value = id;
        document.getElementById('modalCustomerName').value = name;
        new bootstrap.Modal(document.getElementById('awardPointsModal')).show();
    }
</script>
}
