@model List<Medicine>
@{
    ViewData["Title"] = "Medicine Inventory";
    bool canEdit = ViewBag.CanEdit;
    var totalUnits = Model.Sum(m => m.TotalStock);
    var lowStockCount = Model.Count(m => m.TotalStock <= m.ReorderLevel);
    var totalValuation = Model.Sum(m => m.TotalStock * m.UnitPrice);
}

<!-- Inventory Header & Metrics -->
<div class="d-flex flex-wrap gap-3 mb-4">
    <div class="stat-card">
        <div class="stat-icon icon-dark">
            <i class="bi bi-capsule-pill"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Total Pharmaceutical SKUs</div>
            <div class="stat-value">@Model.Count <span style="font-size: 13px; font-weight: 500; color: #7b809a;">products</span></div>
        </div>
        <div class="stat-footer">
            <span class="text-success fw-bold">Active</span> catalog items
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-blue">
            <i class="bi bi-boxes"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Total Units on Hand</div>
            <div class="stat-value">@totalUnits.ToString("N0") <span style="font-size: 13px; font-weight: 500; color: #7b809a;">units</span></div>
        </div>
        <div class="stat-footer">
            <span class="text-success fw-bold">+3%</span> vs last month
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-amber">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Reorder Alerts</div>
            <div class="stat-value text-warning">@lowStockCount <span style="font-size: 13px; font-weight: 500; color: #7b809a;">items</span></div>
        </div>
        <div class="stat-footer">
            <span class="text-danger fw-bold">-3%</span> stock deficit
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-green">
            <i class="bi bi-cash-stack"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Inventory Valuation</div>
            <div class="stat-value text-success">₱@totalValuation.ToString("N2")</div>
        </div>
        <div class="stat-footer">
            <span class="text-success fw-bold">+8%</span> total asset value
        </div>
    </div>
</div>

<div class="table-card">
    <div class="table-card-header flex-wrap gap-2">
        <div>
            <div class="fw-bold fs-6" style="color: var(--cp-forest-deep);"><i class="bi bi-card-list text-success me-2"></i>Pharmaceutical Products Catalog</div>
            <div class="text-muted" style="font-size: 12px;">Comprehensive medicine registry with generic formulation, manufacturer lab, and batch tracking</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <form method="get" class="d-flex">
                <div class="input-group input-group-sm" style="width: 260px;">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search brand or generic..." />
                    <button class="btn btn-outline-secondary" type="submit">Filter</button>
                </div>
            </form>
            @if (canEdit)
            {
                <a asp-action="Create" class="btn btn-sm btn-careplus d-inline-flex align-items-center gap-1">
                    <i class="bi bi-plus-lg"></i> Add Medicine
                </a>
            }
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Medicine / Brand</th>
                    <th>Generic Name</th>
                    <th>Category</th>
                    <th>Manufacturer</th>
                    <th>Stock on Hand</th>
                    <th>Unit Price</th>
                    <th>Nearest Expiry</th>
                    <th>Status</th>
                    @if (canEdit)
                    {
                        <th class="text-end">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-5">
                            <i class="bi bi-capsule fs-2 d-block mb-2 text-muted"></i>
                            No medicines match your search criteria.
                        </td>
                    </tr>
                }
                @foreach (var m in Model)
                {
                    var isOutOfStock = m.TotalStock == 0;
                    var isLowStock = !isOutOfStock && m.TotalStock <= m.ReorderLevel;
                    var isNearExpiry = m.NearestExpiry.HasValue && m.NearestExpiry.Value <= DateTime.Today.AddDays(45);

                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@m.Id" class="fw-bold text-dark text-decoration-none">
                                @m.Name
                            </a>
                            <div class="text-muted" style="font-size: 11px;">Reorder at: @m.ReorderLevel units</div>
                        </td>
                        <td>
                            <span class="text-muted" style="font-size: 12px;">
                                @(string.IsNullOrEmpty(m.GenericName) ? "Formula" : m.GenericName)
                            </span>
                        </td>
                        <td>
                            <span class="text-muted" style="font-size: 12.5px;">@m.Category</span>
                        </td>
                        <td>
                            <span class="text-muted" style="font-size: 12px;">@(m.Manufacturer ?? "Standard")</span>
                        </td>
                        <td>
                            <span class="fw-bold fs-6 @(isOutOfStock ? "text-danger" : (isLowStock ? "text-warning" : "text-dark"))">
                                @m.TotalStock units
                            </span>
                        </td>
                        <td>
                            <span class="fw-bold text-success">₱@m.UnitPrice.ToString("N2")</span>
                        </td>
                        <td>
                            @if (m.NearestExpiry.HasValue)
                            {
                                <span class="@(isNearExpiry ? "text-danger fw-bold" : "text-muted")" style="font-size: 12px;">
                                    @m.NearestExpiry.Value.ToString("yyyy-MM-dd")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted" style="font-size: 11px;">No active batch</span>
                            }
                        </td>
                        <td>
                            @if (isOutOfStock)
                            {
                                <span class="text-danger fw-semibold">Out of Stock</span>
                            }
                            else if (isLowStock)
                            {
                                <span class="text-warning fw-semibold">Low Stock</span>
                            }
                            else
                            {
                                <span class="text-success fw-semibold">Optimal</span>
                            }
                        </td>
                        @if (canEdit)
                        {
                            <td class="text-end">
                                <a asp-action="AddBatch" asp-route-medicineId="@m.Id" class="btn btn-sm btn-outline-success py-1 px-2 me-2" style="font-size: 12px;" title="Add Stock Batch">
                                    <i class="bi bi-plus-circle me-1"></i> Stock-In
                                </a>
                                <a asp-action="Edit" asp-route-id="@m.Id" class="action-icon text-secondary me-2" title="Edit Medicine">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@m.Id" class="action-icon text-danger" title="Archive Medicine">
                                    <i class="bi bi-archive"></i>
                                </a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
