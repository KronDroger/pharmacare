@model Medicine
@{
    ViewData["Title"] = "Add Medicine to Inventory";
}

<div class="table-card p-4" style="max-width: 640px;">
    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
        <i class="bi bi-capsule-pill fs-4 text-success"></i>
        <div>
            <h5 class="fw-bold mb-0 text-dark">Register New Pharmaceutical Medicine</h5>
            <div class="text-muted" style="font-size: 12px;">Ensure brand name, generic chemical formula, and manufacturer are recorded</div>
        </div>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold" style="font-size: 13px;">Brand / Trade Name *</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Biogesic 500mg" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold" style="font-size: 13px;">Generic / Chemical Name</label>
                <input asp-for="GenericName" class="form-control" placeholder="e.g. Paracetamol" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold" style="font-size: 13px;">Therapeutic Category *</label>
                <input asp-for="Category" class="form-control" placeholder="e.g. Analgesic, Antibiotics, Cardiovascular" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold" style="font-size: 13px;">Manufacturer / Lab</label>
                <input asp-for="Manufacturer" class="form-control" placeholder="e.g. Unilab, GSK, Pfizer" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold" style="font-size: 13px;">Clinical Description / Indications</label>
            <textarea asp-for="Description" class="form-control" rows="2" placeholder="Indications, dosage form, or storage requirements..."></textarea>
        </div>

        <div class="row">
            <div class="col-6 mb-3">
                <label class="form-label fw-semibold" style="font-size: 13px;">Retail Unit Price (₱) *</label>
                <div class="input-group">
                    <span class="input-group-text bg-white">₱</span>
                    <input asp-for="UnitPrice" type="number" step="0.01" min="0" class="form-control" required />
                </div>
            </div>
            <div class="col-6 mb-3">
                <label class="form-label fw-semibold" style="font-size: 13px;">Reorder Alert Level *</label>
                <input asp-for="ReorderLevel" type="number" min="0" class="form-control" value="50" required />
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold" style="font-size: 13px;">Designated Supplier *</label>
            <select asp-for="SupplierId" class="form-select" required>
                @foreach (var s in (List<Supplier>)ViewBag.Suppliers)
                {
                    <option value="@s.Id">@s.Name (@s.Address)</option>
                }
            </select>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-careplus px-4">Save to Catalog</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
