@model Medicine
@{
    ViewData["Title"] = $"{Model.Name} - Details";
    var isLowStock = Model.TotalStock <= Model.ReorderLevel;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0 text-dark">@Model.Name</h4>
        <div class="text-muted" style="font-size: 13px;">
            Generic: <strong>@(string.IsNullOrEmpty(Model.GenericName) ? "Standard Formula" : Model.GenericName)</strong> · 
            Manufacturer: <strong>@(Model.Manufacturer ?? "Standard")</strong>
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin") || User.IsInRole("InventoryCoordinator"))
        {
            <a asp-action="AddBatch" asp-route-medicineId="@Model.Id" class="btn btn-sm btn-careplus">
                <i class="bi bi-plus-circle me-1"></i> Add Stock Batch
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
        }
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Inventory</a>
    </div>
</div>

<div class="table-card p-4 mb-4">
    <div class="row g-4">
        <div class="col-md-3">
            <div class="text-muted text-uppercase" style="font-size: 11px; font-weight: 700;">Total Stock on Hand</div>
            <div class="fs-4 fw-bold @(isLowStock ? "text-danger" : "text-dark")">@Model.TotalStock units</div>
            <div class="text-muted" style="font-size: 11px;">Reorder alert at @Model.ReorderLevel units</div>
        </div>
        <div class="col-md-3">
            <div class="text-muted text-uppercase" style="font-size: 11px; font-weight: 700;">Retail Selling Price</div>
            <div class="fs-4 fw-bold text-success">₱@Model.UnitPrice.ToString("N2")</div>
            <div class="text-muted" style="font-size: 11px;">Per dispensing unit</div>
        </div>
        <div class="col-md-3">
            <div class="text-muted text-uppercase" style="font-size: 11px; font-weight: 700;">Therapeutic Category</div>
            <div class="fs-5 fw-bold text-dark">@Model.Category</div>
            <div class="text-muted" style="font-size: 11px;">Classification</div>
        </div>
        <div class="col-md-3">
            <div class="text-muted text-uppercase" style="font-size: 11px; font-weight: 700;">Primary Supplier</div>
            <div class="fs-6 fw-bold text-dark">@(Model.Supplier?.Name ?? "—")</div>
            <div class="text-muted" style="font-size: 11px;">@(Model.Supplier?.ContactNumber ?? "Direct")</div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div class="mt-4 pt-3 border-top">
            <div class="text-muted text-uppercase mb-1" style="font-size: 11px; font-weight: 700;">Clinical Indications &amp; Usage Notes</div>
            <p class="mb-0 text-dark" style="font-size: 13.5px; line-height: 1.5;">@Model.Description</p>
        </div>
    }
</div>

<!-- Stock Batches Table -->
<div class="table-card">
    <div class="table-card-header">
        <div>
            <div class="fw-bold fs-6" style="color: var(--cp-forest-deep);"><i class="bi bi-box-seam text-success me-2"></i>Active Medicine Batches</div>
            <div class="text-muted" style="font-size: 12px;">Physical inventory lot tracking for expiry safety and FIFO dispensing</div>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("InventoryCoordinator"))
        {
            <a asp-action="AddBatch" asp-route-medicineId="@Model.Id" class="btn btn-sm btn-outline-careplus">
                <i class="bi bi-plus-lg me-1"></i> New Batch
            </a>
        }
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Batch Lot #</th>
                    <th>Remaining Quantity</th>
                    <th>Date Received</th>
                    <th>Expiration Date</th>
                    <th>Days Remaining</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Batches.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No batches recorded for this medicine.
                        </td>
                    </tr>
                }
                @foreach (var b in Model.Batches.OrderBy(b => b.ExpiryDate))
                {
                    var days = (b.ExpiryDate.Date - DateTime.Today).Days;
                    <tr>
                        <td class="fw-bold font-monospace">@b.BatchNumber</td>
                        <td>
                            <span class="fw-bold fs-6 @(b.Quantity <= 0 ? "text-muted" : "text-dark")">@b.Quantity units</span>
                        </td>
                        <td>@b.DateReceived.ToString("yyyy-MM-dd")</td>
                        <td class="fw-semibold">@b.ExpiryDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (days < 0)
                            {
                                <span class="text-danger fw-bold">Expired</span>
                            }
                            else
                            {
                                <span>@days days</span>
                            }
                        </td>
                        <td>
                            @if (b.Quantity <= 0)
                            {
                                <span class="badge bg-secondary">Depleted</span>
                            }
                            else if (days < 0)
                            {
                                <span class="badge bg-danger">Expired</span>
                            }
                            else if (days <= 30)
                            {
                                <span class="badge bg-warning text-dark">Critical (&le; 30d)</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Active Batch</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
