@model CarePlusPharmacy.Models.PaginatedList<CustomerSubscription>
@{ ViewData["Title"] = "Due Refills"; }

<div class="table-card">
    <div class="table-card-header">
        <div>
            <div class="fw-bold fs-6" style="color: var(--cp-forest-deep);"><i class="bi bi-clock-history text-success me-2"></i>Refills Due Today</div>
            <div class="text-muted" style="font-size: 12px;">Process a refill to generate the Sale and Invoice automatically</div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Plan</th>
                    <th>Due Date</th>
                    <th class="num">Amount</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-5">No refills due right now.</td></tr>
                }
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-bold">@s.Customer?.FullName</td>
                        <td>@s.SubscriptionPlan?.Name</td>
                        <td>@s.NextRefillDate.ToString("yyyy-MM-dd")</td>
                        <td class="num">₱@((s.SubscriptionPlan?.Price ?? 0).ToString("N2"))</td>
                        <td class="text-end">
                            <form asp-action="ProcessRefill" asp-route-id="@s.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-careplus">Process Refill</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", Model)
</div>
