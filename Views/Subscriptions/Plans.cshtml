@model CarePlusPharmacy.Models.PaginatedList<SubscriptionPlan>
@{ ViewData["Title"] = "Subscription Plans"; }

<div class="table-card">
    <div class="table-card-header flex-wrap gap-2">
        <div>
            <div class="fw-bold fs-6" style="color: var(--cp-forest-deep);"><i class="bi bi-arrow-repeat text-success me-2"></i>Subscription Plans</div>
            <div class="text-muted" style="font-size: 12px;">Auto-refill plans customers can subscribe to</div>
        </div>
        <a asp-action="PlanCreate" class="btn btn-sm btn-careplus d-inline-flex align-items-center gap-1">
            <i class="bi bi-plus-lg"></i> New Plan
        </a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Plan Name</th>
                    <th>Medicine</th>
                    <th class="num">Qty / Refill</th>
                    <th>Interval</th>
                    <th class="num">Price</th>
                    <th>Status</th>
                    <th class="num">Subscribers</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-5">No subscription plans yet.</td></tr>
                }
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-bold">@p.Name</td>
                        <td>@(p.Medicine?.Name ?? "—")</td>
                        <td class="num">@p.Quantity.ToString("N0")</td>
                        <td>Every @p.IntervalDays days</td>
                        <td class="num">₱@p.Price.ToString("N2")</td>
                        <td>
                            @if (p.IsActive) { <span class="badge bg-success">Active</span> }
                            else { <span class="badge bg-secondary">Inactive</span> }
                        </td>
                        <td class="num">@p.Subscriptions.Count(s => s.Status == SubscriptionStatus.Active).ToString("N0")</td>
                        <td class="text-end">
                            <a asp-action="PlanEdit" asp-route-id="@p.Id" class="action-icon text-secondary me-2" title="Edit"><i class="bi bi-pencil"></i></a>
                            <form asp-action="PlanDelete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this plan?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="action-icon text-danger border-0 bg-transparent" title="Delete"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", Model)
</div>
