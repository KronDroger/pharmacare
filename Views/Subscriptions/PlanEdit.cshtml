@model SubscriptionPlan
@{ ViewData["Title"] = "Edit Refill Plan"; }

<div class="table-card p-4" style="max-width:560px;">
    <form asp-action="PlanEdit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <div class="mb-3">
            <label class="form-label">Plan Name</label>
            <input asp-for="Name" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Medicine</label>
            <select asp-for="MedicineId" class="form-select" required>
                @foreach (var m in (List<Medicine>)ViewBag.Medicines)
                {
                    <option value="@m.Id" selected="@(m.Id == Model.MedicineId)">@m.Name (@m.GenericName)</option>
                }
            </select>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Quantity per Refill</label>
                <input asp-for="Quantity" type="number" min="1" class="form-control num" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Interval (days)</label>
                <input asp-for="IntervalDays" type="number" min="1" class="form-control num" required />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Price per Refill (₱)</label>
            <input asp-for="Price" type="number" step="0.01" min="0" class="form-control num" required />
        </div>
        <div class="form-check mb-3">
            <input type="hidden" name="IsActive" value="false" />
            <input asp-for="IsActive" class="form-check-input" />
            <label class="form-check-label">Active / Available for subscription</label>
        </div>
        <button type="submit" class="btn btn-accent">Save Changes</button>
        <a asp-action="Plans" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
