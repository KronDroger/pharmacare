@model CarePlusPharmacy.Models.PaginatedList<CustomerSubscription>
@{ ViewData["Title"] = "My Subscriptions"; }

<div class="table-card">
    <div class="table-card-header">
        <div>
            <div class="fw-bold fs-6" style="color: var(--cp-forest-deep);"><i class="bi bi-arrow-repeat text-success me-2"></i>My Subscriptions</div>
            <div class="text-muted" style="font-size: 12px;">Your active and past refill subscriptions</div>
        </div>
        <a asp-action="Browse" class="btn btn-sm btn-careplus">Browse Plans</a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Plan</th>
                    <th>Next Refill</th>
                    <th>Status</th>
                    <th>Payment Method</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-5">You have no subscriptions yet. <a asp-action="Browse">Browse plans</a>.</td></tr>
                }
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-bold">@s.SubscriptionPlan?.Name</td>
                        <td>@s.NextRefillDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            @switch (s.Status)
                            {
                                case SubscriptionStatus.Active:
                                    <span class="badge bg-success">Active</span>
                                    break;
                                case SubscriptionStatus.Paused:
                                    <span class="badge bg-warning text-dark">Paused</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">Cancelled</span>
                                    break;
                            }
                        </td>
                        <td>@s.PaymentMethod</td>
                        <td class="text-end">
                            @if (s.Status == SubscriptionStatus.Active)
                            {
                                <form asp-action="Cancel" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Cancel this subscription?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", Model)
</div>
