@model List<CarePlusPharmacy.Models.Prescription>
@{
    ViewData["Title"] = "My Prescriptions";
}

<div class="table-card">
    <div class="table-card-header">
        <div>
            <div class="fw-bold fs-6" style="color: var(--cp-forest-deep);"><i class="bi bi-file-earmark-medical text-success me-2"></i>My Prescriptions</div>
            <div class="text-muted" style="font-size: 12px;">Prescriptions on file under your patient record</div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-file-earmark-medical d-block mb-2" style="font-size: 2.2rem;"></i>
            No prescriptions on file yet.
        </div>
    }

    @foreach (var p in Model)
    {
        <div class="border-top p-4" style="border-color: var(--cp-border-subtle);">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <div class="fw-bold">Rx #@p.Id</div>
                    <div class="text-muted" style="font-size: 12px;">Dr. @p.DoctorName · Written @p.DatePrescribed.ToString("yyyy-MM-dd")</div>
                </div>
                @switch (p.Status)
                {
                    case PrescriptionStatus.Pending:
                        <span class="badge" style="background-color: var(--cp-warning-bg); color: var(--cp-warning);">Pending</span>
                        break;
                    case PrescriptionStatus.Fulfilled:
                        <span class="badge" style="background-color: var(--cp-success-bg); color: var(--cp-success);">Fulfilled</span>
                        break;
                    default:
                        <span class="badge bg-secondary">Cancelled</span>
                        break;
                }
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Medicine</th>
                            <th>Dosage</th>
                            <th class="num">Prescribed Qty</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in p.Details)
                        {
                            <tr>
                                <td class="fw-semibold">@d.Medicine?.Name</td>
                                <td class="text-muted">@d.Dosage</td>
                                <td class="num">@d.Quantity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>