@model CarePlusPharmacy.Models.ViewModels.PortalRewardsViewModel
@{
    ViewData["Title"] = "My Rewards";
    var c = Model.Customer;
}

@if (c == null)
{
    <div class="table-card p-5 text-center">
        <i class="bi bi-gift fs-1 text-muted d-block mb-3"></i>
        <div class="fw-bold fs-5">No linked patient profile</div>
        <div class="text-muted mt-1">Ask the pharmacy to link your account to your patient record so you can use the portal.</div>
    </div>
    return;
}

<div class="d-flex flex-wrap gap-3 mb-4">
    <div class="stat-card">
        <div class="stat-icon icon-amber">
            <i class="bi bi-gift"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Current Points</div>
            <div class="stat-value text-warning">@c.LoyaltyPoints <span style="font-size: 14px; font-weight: 500; color: var(--cp-text-muted);">pts</span></div>
        </div>
        <div class="stat-footer">
            <span class="text-warning fw-bold">@c.Tier</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-green">
            <i class="bi bi-trophy"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Next Tier</div>
            @if (c.LoyaltyPoints >= 500)
            {
                <div class="stat-value">Platinum VIP</div>
            }
            else if (c.LoyaltyPoints >= 250)
            {
                <div class="stat-value">Platinum VIP</div>
            }
            else if (c.LoyaltyPoints >= 100)
            {
                <div class="stat-value">Gold Member</div>
            }
            else
            {
                <div class="stat-value">Silver Member</div>
            }
        </div>
        <div class="stat-footer">
            @if (c.LoyaltyPoints >= 500)
            {
                <span class="text-success fw-bold"><i class="bi bi-trophy-fill"></i> Highest tier reached</span>
            }
            else if (c.LoyaltyPoints >= 250)
            {
                <span class="text-muted small">@(500 - c.LoyaltyPoints) pts to Platinum VIP</span>
            }
            else if (c.LoyaltyPoints >= 100)
            {
                <span class="text-muted small">@(250 - c.LoyaltyPoints) pts to Gold Member</span>
            }
            else
            {
                <span class="text-muted small">@(100 - c.LoyaltyPoints) pts to Silver Member</span>
            }
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-blue">
            <i class="bi bi-info-circle"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">How Points Work</div>
            <div class="stat-value text-info" style="font-size: 20px;">₱100 = 1 pt</div>
        </div>
        <div class="stat-footer">
            <span class="text-muted small">Earn on every purchase, redeem at the counter</span>
        </div>
    </div>
</div>

<div class="table-card">
    <div class="table-card-header">
        <div>
            <div class="fw-bold fs-6" style="color: var(--cp-forest-deep);"><i class="bi bi-clock-history text-success me-2"></i>Points History</div>
            <div class="text-muted" style="font-size: 12px;">Recent point earnings and redemptions (latest 50)</div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Invoice</th>
                    <th>Transaction</th>
                    <th class="num">Amount</th>
                    <th class="num">Points</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Transactions.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5">
                            <i class="bi bi-stars fs-2 d-block mb-2 text-muted"></i>
                            No points activity yet. Points are earned on every purchase.
                        </td>
                    </tr>
                }
                @foreach (var s in Model.Transactions)
                {
                    <tr>
                        <td>@s.SaleDate.ToString("yyyy-MM-dd")</td>
                        <td>@(s.Billing?.InvoiceNumber ?? $"INV-{s.Id:D5}")</td>
                        <td>
                            <span class="text-muted">Purchase @s.Details.Count item(s)</span>
                        </td>
                        <td class="num">₱@s.TotalAmount.ToString("N2")</td>
                        <td class="num">
                            @if (s.PointsEarned > 0)
                            {
                                <span class="badge" style="background-color: var(--cp-success-bg); color: var(--cp-success);">+@s.PointsEarned</span>
                            }
                            @if (s.PointsRedeemed > 0)
                            {
                                <span class="badge" style="background-color: var(--cp-danger-bg); color: var(--cp-danger);">-@s.PointsRedeemed</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>