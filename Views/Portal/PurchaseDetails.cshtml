@model CarePlusPharmacy.Models.Sale
@{
    ViewData["Title"] = $"Purchase #{Model.Id}";
}

<div class="mb-3">
    <a asp-action="Purchases" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Purchases</a>
</div>

<div class="table-card">
    <div class="table-card-header">
        <div>
            <div class="fw-bold fs-6" style="color: var(--cp-forest-deep);"><i class="bi bi-receipt text-success me-2"></i>Purchase #@Model.Id</div>
            <div class="text-muted" style="font-size: 12px;">@(Model.Billing?.InvoiceNumber ?? $"INV-{Model.Id:D5}") · @Model.SaleDate.ToString("yyyy-MM-dd hh:mm tt")</div>
        </div>
        <span class="badge" style="background-color: var(--cp-success-bg); color: var(--cp-success); font-size: 12px;"><i class="bi bi-check-circle me-1"></i>Completed</span>
    </div>

    <div class="p-4">
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="text-muted" style="font-size: 11px; font-weight: 700;">PAYMENT METHOD</div>
                <div>@Model.PaymentMethod</div>
            </div>
            <div class="col-md-6">
                <div class="text-muted" style="font-size: 11px; font-weight: 700;">CASHIER</div>
                <div>@(Model.Cashier?.FullName ?? Model.Cashier?.UserName ?? "Staff")</div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Medicine</th>
                        <th class="num">Unit Price</th>
                        <th class="num">Qty</th>
                        <th class="num">Batch #</th>
                        <th class="num">Line Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Details)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@d.Medicine?.Name</div>
                                <div class="text-muted" style="font-size: 11px;">@d.Medicine?.GenericName</div>
                            </td>
                            <td class="num">₱@d.UnitPrice.ToString("N2")</td>
                            <td class="num">@d.Quantity</td>
                            <td class="num text-muted">@(d.Batch?.BatchNumber ?? "—")</td>
                            <td class="num fw-bold">₱@((d.Quantity * d.UnitPrice).ToString("N2"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <div style="width: 280px; max-width: 100%;">
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Gross Total</span>
                    <span>₱@Model.GrossAmount.ToString("N2")</span>
                </div>
                @if (Model.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-success">Discount / Points Redeemed</span>
                        <span class="text-success">-₱@Model.DiscountAmount.ToString("N2")</span>
                    </div>
                }
                <div class="d-flex justify-content-between py-2 border-top mt-1" style="border-color: var(--cp-border-subtle);">
                    <span class="fw-bold">Amount Paid</span>
                    <span class="fw-bold fs-5" style="color: var(--cp-forest-deep);">₱@Model.TotalAmount.ToString("N2")</span>
                </div>
                @if (Model.Billing != null)
                {
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">Paid via</span>
                        <span>@Model.Billing.PaymentMethod</span>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">Change</span>
                        <span>₱@Model.Billing.ChangeAmount.ToString("N2")</span>
                    </div>
                }
                @if (Model.PointsEarned > 0)
                {
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-warning">Points Earned</span>
                        <span class="text-warning">+@Model.PointsEarned</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>