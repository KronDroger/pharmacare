@model CarePlusPharmacy.Models.ViewModels.PortalDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
    var c = Model.Customer;
}

@if (c == null)
{
    <div class="table-card p-5 text-center">
        <i class="bi bi-person-x fs-1 text-muted d-block mb-3"></i>
        <div class="fw-bold fs-5">No linked patient profile</div>
        <div class="text-muted mt-1">Ask the pharmacy to link your account to your patient record so you can use the portal.</div>
    </div>
    return;
}

<div class="mb-4">
    <div class="fs-5 fw-bold" style="color: var(--cp-forest-deep);">Hi, @c.FullName</div>
    <div class="text-muted" style="font-size: 13px;">Here's your health and pharmacy summary.</div>
</div>

<div class="d-flex flex-wrap gap-3 mb-4">
    <div class="stat-card">
        <div class="stat-icon icon-amber">
            <i class="bi bi-gift"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Loyalty Points</div>
            <div class="stat-value text-warning">@c.LoyaltyPoints</div>
        </div>
        <div class="stat-footer">
            <span class="text-warning fw-bold">@c.Tier</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-green">
            <i class="bi bi-arrow-repeat"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Active Refill Plans</div>
            <div class="stat-value">@Model.ActiveSubscriptionCount</div>
        </div>
        <div class="stat-footer">
            <span class="text-muted small">@Model.PausedSubscriptionCount paused</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-blue">
            <i class="bi bi-bag-check"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Total Purchases</div>
            <div class="stat-value">@Model.PurchaseCount</div>
        </div>
        <div class="stat-footer">
            <span class="text-muted small">Lifetime at CarePlus</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-purple">
            <i class="bi bi-file-earmark-medical"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Pending Prescriptions</div>
            <div class="stat-value">@Model.PendingPrescriptionCount</div>
        </div>
        <div class="stat-footer">
            <a asp-action="Prescriptions" class="small text-decoration-none">View all</a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="table-card h-100">
            <div class="table-card-header">
                <div>
                    <div class="fw-bold fs-6" style="color: var(--cp-forest-deep);"><i class="bi bi-clock-history text-success me-2"></i>Recent Purchases</div>
                    <div class="text-muted" style="font-size: 12px;">Your latest orders with CarePlus</div>
                </div>
                <a asp-action="Purchases" class="btn btn-sm btn-outline-careplus">View All</a>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Invoice</th>
                            <th>Items</th>
                            <th class="num">Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentPurchases.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-5">No purchases yet.</td></tr>
                        }
                        @foreach (var s in Model.RecentPurchases)
                        {
                            <tr>
                                <td>@s.SaleDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="fw-semibold">@(s.Billing?.InvoiceNumber ?? $"INV-{s.Id:D5}")</span>
                                </td>
                                <td>
                                    <span class="badge" style="background-color: var(--cp-mint-subtle); color: var(--cp-forest);">@s.Details.Count item(s)</span>
                                </td>
                                <td class="num fw-bold">₱@s.TotalAmount.ToString("N2")</td>
                                <td class="text-end">
                                    <a asp-action="PurchaseDetails" asp-route-id="@s.Id" class="btn btn-sm btn-outline-careplus py-1 px-2" style="font-size: 12px;">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="table-card h-100">
            <div class="table-card-header">
                <div>
                    <div class="fw-bold fs-6" style="color: var(--cp-forest-deep);"><i class="bi bi-arrow-repeat text-success me-2"></i>Active Refill Plans</div>
                    <div class="text-muted" style="font-size: 12px;">Plans you're currently subscribed to</div>
                </div>
                <a asp-controller="Subscriptions" asp-action="Browse" class="btn btn-sm btn-outline-careplus">Add Plan</a>
            </div>

            <div class="p-3">
                @if (!Model.ActiveSubscriptions.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-arrow-repeat d-block mb-2" style="font-size: 2rem;"></i>
                        No active refill plans. <a asp-controller="Subscriptions" asp-action="Browse">Browse plans</a>.
                    </div>
                }
                @foreach (var s in Model.ActiveSubscriptions)
                {
                    <div class="d-flex justify-content-between align-items-center border rounded p-3 mb-2" style="border-color: var(--cp-border-subtle);">
                        <div>
                            <div class="fw-bold">@s.SubscriptionPlan?.Name</div>
                            <div class="text-muted" style="font-size: 12px;">
                                @s.SubscriptionPlan?.Medicine?.Name · next refill @s.NextRefillDate.ToString("yyyy-MM-dd")
                            </div>
                            <div class="text-muted" style="font-size: 12px;">
                                <i class="bi bi-geo-alt me-1"></i>Pickup: @(s.Branch?.Name ?? "Not set")
                            </div>
                        </div>
                        <a asp-action="Subscriptions" class="btn btn-sm btn-outline-careplus">Manage</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>