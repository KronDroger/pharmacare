@model DashboardViewModel
@{
    ViewData["Title"] = "Executive Dashboard";
}


<!-- Key Metric Cards -->
<div class="d-flex flex-wrap gap-3 mb-4">
    <div class="stat-card">
        <div class="stat-icon icon-green">
            <i class="bi bi-currency-dollar"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Total Sales Revenue</div>
            <div class="stat-value">₱@Model.TotalRevenue.ToString("N2")</div>
        </div>
        <div class="stat-footer">
            <span class="text-success fw-bold">+18%</span> vs last month
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-blue">
            <i class="bi bi-capsule"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Stock on Hand</div>
            <div class="stat-value">@Model.TotalStockUnits.ToString("N0") <span style="font-size: 13px; font-weight: 500; color: #7b809a;">units</span></div>
        </div>
        <div class="stat-footer">
            <span class="text-success fw-bold"><i class="bi bi-boxes"></i> Healthy</span> inventory
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-amber">
            <i class="bi bi-exclamation-circle-fill"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Low Stock Items</div>
            <div class="stat-value">@Model.LowStockCount <span style="font-size: 13px; font-weight: 500; color: #7b809a;">items</span></div>
        </div>
        <div class="stat-footer">
            <span class="text-warning fw-bold"><i class="bi bi-clock-history"></i> Reorder</span> threshold
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon icon-red">
            <i class="bi bi-hourglass-bottom"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Expiring &le; 45 Days</div>
            <div class="stat-value text-danger">@Model.ExpiringSoonCount <span style="font-size: 13px; font-weight: 500; color: #e53935;">batches</span></div>
        </div>
        <div class="stat-footer">
            <span class="text-danger fw-bold"><i class="bi bi-shield-slash"></i> Immediate</span> review
        </div>
    </div>
</div>

<!-- Stock By Category Cards -->
<div class="row g-3 mb-4">
    @for (int i = 0; i < Model.StockByCategory.Count; i++)
    {
        var cat = Model.StockByCategory[i];
        <div class="col-6 col-md-4 col-lg-2">
            <div class="category-card @(i == 0 ? "dark" : "")">
                <div class="cat-title text-truncate" title="@cat.Category">@cat.Category</div>
                <div class="cat-count">@cat.Stock</div>
            </div>
        </div>
    }
</div>

<!-- Charts Section -->
<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="table-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="fw-bold" style="font-size: 15px; color: var(--cp-forest-deep);"><i class="bi bi-bar-chart-line text-success me-2"></i>Top-Selling Medicines (Units)</div>
                <span class="badge bg-light text-muted border">POS Real-Time</span>
            </div>
            <div style="position: relative; height: 320px; width: 100%;">
                <canvas id="topMedsChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="table-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="fw-bold" style="font-size: 15px; color: var(--cp-forest-deep);"><i class="bi bi-pie-chart text-success me-2"></i>Stock by Category</div>
                <span class="badge bg-light text-muted border">Inventory Units</span>
            </div>
            <div style="position: relative; height: 320px; width: 100%; display: flex; align-items: center; justify-content: center;">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Sales Transaction Table -->
<div class="table-card">
    <div class="table-card-header">
        <div>
            <div class="fw-bold" style="font-size: 15px; color: var(--cp-forest-deep);"><i class="bi bi-clock-history text-success me-2"></i>Recent Sales Transactions</div>
            <div class="text-muted" style="font-size: 12px;">Live transactions recorded through the Point of Sale module</div>
        </div>
        <a asp-controller="Sales" asp-action="Index" class="btn btn-sm btn-outline-careplus">View All Sales</a>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Invoice / Sale ID</th>
                    <th>Date &amp; Time</th>
                    <th>Customer / CRM Tier</th>
                    <th>Items Dispensed</th>
                    <th class="num">Total Amount</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.RecentSales.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="bi bi-bag-x fs-3 d-block mb-2 text-muted"></i>
                            No sales transactions recorded yet.
                        </td>
                    </tr>
                }
                @foreach (var s in Model.RecentSales)
                {
                    <tr>
                        <td>
                            <span class="fw-bold text-dark">#@s.Id</span>
                            <div class="text-muted" style="font-size: 11px;">INV-@s.Id.ToString("D5")</div>
                        </td>
                        <td>@s.SaleDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (s.Customer != null)
                            {
                                <div class="fw-semibold text-dark">@s.Customer.FullName</div>
                                <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 10.5px;">@s.Customer.Tier (@s.Customer.LoyaltyPoints pts)</span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Walk-in Customer</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@s.Details.Count item(s)</span>
                            <div class="text-muted text-truncate" style="font-size: 11.5px; max-width: 240px;">
                                @string.Join(", ", s.Details.Select(d => d.Medicine?.Name))
                            </div>
                        </td>
                        <td class="num">
                            <span class="fw-bold text-dark fs-6">₱@s.TotalAmount.ToString("N2")</span>
                            <div class="text-muted" style="font-size: 11px;">@s.PaymentMethod</div>
                        </td>
                        <td>
                            <a asp-controller="Sales" asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size: 12px;">
                                <i class="bi bi-eye"></i> Receipt
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const topMedsCtx = document.getElementById('topMedsChart');
        if (topMedsCtx) {
            new Chart(topMedsCtx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.TopSellingMedicines.Select(t => t.MedicineName))),
                    datasets: [{
                        label: 'Units Sold',
                        data: @Html.Raw(Json.Serialize(Model.TopSellingMedicines.Select(t => t.QuantitySold))),
                        backgroundColor: '#10b981',
                        borderRadius: 8,
                        hoverBackgroundColor: '#059669'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    onHover: (evt, activeEls) => {
                        if (evt && evt.native && evt.native.target) {
                            evt.native.target.style.cursor = activeEls && activeEls.length ? 'pointer' : 'default';
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const val = context.raw || 0;
                                    return `${context.dataset.label || 'Units Sold'}: ${val.toLocaleString()} units`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#f0f3f1' } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        const catCtx = document.getElementById('categoryChart');
        if (catCtx) {
            const catLabels = @Html.Raw(Json.Serialize(Model.StockByCategory.Select(c => c.Category)));
            const catData = @Html.Raw(Json.Serialize(Model.StockByCategory.Select(c => c.Stock)));

            function generatePalette(count) {
                const colors = [];
                for (let i = 0; i < count; i++) {
                    const hue = Math.round((i * 360) / Math.max(1, count));
                    colors.push(`hsl(${hue}, 65%, 45%)`);
                }
                return colors;
            }

            new Chart(catCtx, {
                type: 'doughnut',
                data: {
                    labels: catLabels,
                    datasets: [{
                        data: catData,
                        backgroundColor: generatePalette(catLabels.length),
                        borderWidth: 2,
                        borderColor: '#ffffff',
                        hoverOffset: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    events: ['mousemove', 'mouseout', 'click', 'touchstart', 'touchmove'],
                    onHover: (evt, activeEls) => {
                        if (evt && evt.native && evt.native.target) {
                            evt.native.target.style.cursor = activeEls && activeEls.length ? 'pointer' : 'default';
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const val = context.raw || 0;
                                    const dataset = context.chart.data.datasets[0];
                                    const total = dataset.data.reduce((a, b) => a + b, 0);
                                    const pct = total > 0 ? ((val / total) * 100).toFixed(1) : 0;
                                    return `${context.label} - ${val.toLocaleString()} units (${pct}%)`;
                                }
                            }
                        }
                    }
                }
            });
        }
    </script>
}
