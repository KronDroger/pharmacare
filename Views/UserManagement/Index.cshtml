@model List<ApplicationUser>
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "User & Role Management";
    var userRoles = (Dictionary<string, IList<string>>)ViewBag.UserRoles;
    var allRoles = (List<string>)ViewBag.AllRoles;
    var currentUserId = UserManager.GetUserId(User);
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <p class="text-muted mb-0">Assign RBAC roles and manage user activation status. Only Main Admin can access this page.</p>
    </div>
    <button type="button" class="btn btn-sm btn-careplus" data-bs-toggle="modal" data-bs-target="#createStaffModal">
        <i class="bi bi-person-plus-fill me-1"></i> Add Staff Account
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2 mb-3" style="font-size:13.5px;">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 mb-3" style="font-size:13.5px;">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
    </div>
}

<div class="table-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Current Role</th>
                    <th>Account Status</th>
                    <th>Change Role</th>
                    <th class="text-end">Status Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var currentRole = userRoles.ContainsKey(u.Id) && userRoles[u.Id].Any() ? userRoles[u.Id][0] : "—";
                    bool isDeactivated = u.LockoutEnd.HasValue && u.LockoutEnd.Value > DateTimeOffset.UtcNow;
                    bool isSelf = u.Id == currentUserId;

                    <tr>
                        <td class="fw-semibold">@u.FullName</td>
                        <td>@u.Email</td>
                        <td><span class="fw-semibold text-primary">@currentRole</span></td>
                        <td>
                            @if (isDeactivated)
                            {
                                <span class="text-danger fw-semibold">
                                    <i class="bi bi-slash-circle me-1"></i>Deactivated
                                </span>
                            }
                            else
                            {
                                <span class="text-success fw-semibold">
                                    <i class="bi bi-check-circle me-1"></i>Active
                                </span>
                            }
                        </td>
                        <td>
                            <form asp-action="ChangeRole" method="post" class="d-flex gap-2">
                                <input type="hidden" name="userId" value="@u.Id" />
                                <select name="newRole" class="form-select form-select-sm" style="width:160px;">
                                    @foreach (var role in allRoles)
                                    {
                                        if (role == currentRole)
                                        {
                                            <option value="@role" selected>@role</option>
                                        }
                                        else
                                        {
                                            <option value="@role">@role</option>
                                        }
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
                            </form>
                        </td>
                        <td class="text-end">
                            @if (isSelf)
                            {
                                <span class="text-muted fst-italic" style="font-size:12px;">Current Session</span>
                            }
                            else
                            {
                                <form asp-action="ToggleStatus" method="post" class="d-inline">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    @if (isDeactivated)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success py-1 px-2" style="font-size: 12px;">
                                            <i class="bi bi-check2-circle me-1"></i> Activate
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 12px;"
                                                onclick="return confirm('Deactivate @u.FullName (@u.Email)? They will be unable to log in until re-activated.');">
                                            <i class="bi bi-slash-circle me-1"></i> Deactivate
                                        </button>
                                    }
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal for creating new Staff Account with Auto-Generate Strong Password -->
<div class="modal fade" id="createStaffModal" tabindex="-1" aria-labelledby="createStaffModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="createStaffModalLabel" style="font-size: 16px;">
                    <i class="bi bi-person-plus-fill text-success me-1"></i> Add Staff Account
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateStaffUser" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size: 13px;">Full Name</label>
                        <input type="text" name="fullName" class="form-control" placeholder="e.g. Dra. Maria Clara" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size: 13px;">Email Address</label>
                        <input type="email" name="email" class="form-control" placeholder="staff@careplus.ph" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size: 13px;">Initial Role</label>
                        <select name="role" class="form-select">
                            @foreach (var role in allRoles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold mb-0" style="font-size: 13px;">Password</label>
                            <button type="button" class="btn btn-link p-0 text-success text-decoration-none fw-semibold" style="font-size: 12px;" onclick="generateStaffPassword()">
                                <i class="bi bi-key-fill me-1"></i> Suggest strong password
                            </button>
                        </div>
                        <div class="input-group">
                            <input type="password" id="staffPasswordInput" name="password" class="form-control" placeholder="••••••••" required minlength="6" />
                            <button class="btn btn-outline-secondary" type="button" onclick="toggleStaffPwVisibility(this)" title="Show/Hide Password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <div id="staffPwFeedback" class="text-success mt-1 fw-semibold d-none" style="font-size: 11.5px;">
                            <i class="bi bi-check-circle-fill me-1"></i> Strong password generated &amp; copied to clipboard!
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-careplus">Create Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function generateStaffPassword() {
        const length = 16;
        const upper = "ABCDEFGHJKLMNPQRSTUVWXYZ";
        const lower = "abcdefghijkmnopqrstuvwxyz";
        const digits = "23456789";
        const symbols = "!@@#$%^&*()_+~=";
        const all = upper + lower + digits + symbols;
        
        let pwd = [
            upper[Math.floor(Math.random() * upper.length)],
            lower[Math.floor(Math.random() * lower.length)],
            digits[Math.floor(Math.random() * digits.length)],
            symbols[Math.floor(Math.random() * symbols.length)]
        ];
        
        const array = new Uint32Array(length - 4);
        window.crypto.getRandomValues(array);
        for (let i = 0; i < array.length; i++) {
            pwd.push(all[array[i] % all.length]);
        }
        
        pwd = pwd.sort(() => 0.5 - Math.random()).join('');
        
        const input = document.getElementById('staffPasswordInput');
        input.value = pwd;
        input.type = 'text';
        
        navigator.clipboard.writeText(pwd).catch(() => {});
        
        const fb = document.getElementById('staffPwFeedback');
        if (fb) {
            fb.classList.remove('d-none');
            setTimeout(() => fb.classList.add('d-none'), 5000);
        }
    }

    function toggleStaffPwVisibility(btn) {
        const input = document.getElementById('staffPasswordInput');
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye');
        }
    }
</script>
