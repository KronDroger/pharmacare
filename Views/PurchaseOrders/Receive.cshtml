@model CarePlusPharmacy.Models.ViewModels.PurchaseOrderReceiveViewModel
@{
    ViewData["Title"] = $"Receive Purchase Order #{Model.OrderNumber}";
}

<div class="table-card">
    <div class="table-card-header">
        <div>
            <div class="fw-bold fs-6" style="color: var(--cp-forest-deep);"><i class="bi bi-box-arrow-in-down text-success me-2"></i>Receive Stock — PO #@Model.OrderNumber</div>
            <div class="text-muted" style="font-size: 12px;">Supplier: <strong>@Model.SupplierName</strong> &middot; Ordered: @Model.OrderDate.ToString("yyyy-MM-dd") — assign a real batch number &amp; expiry date to each line then confirm.</div>
        </div>
    </div>

    <form asp-action="Receive" method="post">
        <input type="hidden" asp-for="PurchaseOrderId" />
        @Html.AntiForgeryToken()

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Medicine</th>
                        <th class="num">Qty</th>
                        <th class="num">Cost/unit</th>
                        <th style="min-width: 180px;">Batch Number</th>
                        <th style="min-width: 160px;">Expiry Date</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Lines.Count; i++)
                    {
                        var line = Model.Lines[i];
                        <tr>
                            <td>
                                <input type="hidden" asp-for="Lines[i].DetailId" />
                                <div class="fw-bold text-dark">@line.MedicineName</div>
                                <div class="text-muted" style="font-size: 11.5px;">@(line.GenericName ?? "Standard Formula")</div>
                            </td>
                            <td class="num">@line.Quantity.ToString("N0")</td>
                            <td class="num">₱@line.UnitCost.ToString("N2")</td>
                            <td>
                                <input asp-for="Lines[i].BatchNumber" class="form-control form-control-sm" placeholder="e.g. B-2026-09" required />
                            </td>
                            <td>
                                <input asp-for="Lines[i].ExpiryDate" type="date" class="form-control form-control-sm" required />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="p-3 border-top d-flex align-items-center justify-content-between">
            <div class="text-muted" style="font-size: 12.5px;">
                <i class="bi bi-info-circle me-1"></i> Confirming this PO adds the ordered quantities to sellable stock immediately.
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-accent"><i class="bi bi-check2-circle me-1"></i> Confirm Receiving</button>
            </div>
        </div>
    </form>
</div>