@{ ViewData["Title"] = "New Purchase Order"; }
<div class="table-card p-4" style="max-width:520px;">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label">Supplier</label>
            <select name="supplierId" class="form-select" required>
                @foreach (var s in (List<Supplier>)ViewBag.Suppliers)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Medicine</label>
            <select name="medicineId" class="form-select" required>
                @foreach (var m in (List<Medicine>)ViewBag.Medicines)
                {
                    <option value="@m.Id">@m.Name</option>
                }
            </select>
        </div>
        <div class="row">
            <div class="col-6 mb-3"><label class="form-label">Quantity</label><input name="quantity" type="number" min="1" class="form-control" required /></div>
            <div class="col-6 mb-3"><label class="form-label">Cost per unit (₱)</label><input name="unitCost" type="number" step="0.01" min="0" class="form-control" required /></div>
        </div>
        <button type="submit" class="btn btn-accent">Create PO</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
