@model CarePlusPharmacy.Models.PaginatedList<PurchaseOrder>
@{ ViewData["Title"] = "Purchasing"; }

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h5 class="fw-bold mb-0" style="color: var(--cp-forest-deep);"><i class="bi bi-box-seam me-2"></i>Purchase Orders</h5>
        <div class="text-muted" style="font-size: 12px;">Supplier restock orders with batch receiving and expiry tracking</div>
    </div>
    <a asp-action="Create" class="btn btn-accent"><i class="bi bi-plus-lg"></i> New Purchase Order</a>
</div>

@await Html.PartialAsync("_FilterBar")

<div class="table-card">
    <table class="table align-middle mb-0">
        <thead><tr><th>PO ID</th><th>Date</th><th>Supplier</th><th>Item</th><th class="num">Qty</th><th class="num">Cost/unit</th><th class="num">Total</th><th>Status</th><th>Action</th></tr></thead>
        <tbody>
            @if (!Model.Any()) { <tr><td colspan="9" class="text-center text-muted py-4">No purchase orders yet.</td></tr> }
            @foreach (var po in Model)
            {
                var item = po.Details.FirstOrDefault();
                <tr>
                    <td>#@po.Id</td>
                    <td>@po.OrderDate.ToString("yyyy-MM-dd")</td>
                    <td>@(po.Supplier?.Name ?? "—")</td>
                    <td>@(item?.Medicine?.Name ?? "—")</td>
                    <td class="num">@((item?.Quantity ?? 0).ToString("N0"))</td>
                    <td class="num">₱@((item?.UnitCost ?? 0).ToString("N2"))</td>
                    <td class="num fw-bold">₱@po.TotalCost.ToString("N2")</td>
                    <td>
                        @if (po.Status == PurchaseOrderStatus.Received) { <span class="badge text-bg-success">Received</span> }
                        else if (po.Status == PurchaseOrderStatus.Cancelled) { <span class="badge text-bg-secondary">Cancelled</span> }
                        else { <span class="badge text-bg-warning">Pending</span> }
                    </td>
                    <td>
                        @if (po.Status == PurchaseOrderStatus.Pending)
                        {
                            <a asp-action="Receive" asp-route-id="@po.Id" class="btn btn-sm btn-accent">
                                <i class="bi bi-box-arrow-in-down me-1"></i> Receive Stock
                            </a>
                            <form asp-action="Cancel" asp-route-id="@po.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Cancel</button>
                            </form>
                        }
                        <form asp-action="Delete" asp-route-id="@po.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this purchase order?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pagination", Model)
</div>
