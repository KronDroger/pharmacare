@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _env
@inject Microsoft.Extensions.Configuration.IConfiguration _config
@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-card text-center">
    <div class="mb-4">
        <img src="~/images/careplus-logo-vertical.svg" alt="CarePlus Pharmacy" style="max-width: 170px; height: auto;" />
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2 text-start" style="font-size:13px;">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div><i class="bi bi-exclamation-circle me-1"></i> @error.ErrorMessage</div>
            }
        </div>
    }

    <form id="loginForm" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="text-start">
        <div class="mb-3">
            <label class="form-label fw-semibold" style="font-size: 13px;">Email Address</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-envelope text-muted"></i></span>
                <input type="email" id="emailInput" name="email" class="form-control" placeholder="name@careplus.ph" required autofocus />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold" style="font-size: 13px;">Password</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-lock text-muted"></i></span>
                <input type="password" id="passwordInput" name="password" class="form-control" placeholder="••••••••" required />
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="form-check mb-0">
                <input type="checkbox" name="rememberMe" value="true" class="form-check-input" id="rememberMe" />
                <label class="form-check-label" for="rememberMe" style="font-size:13px;">Remember me</label>
            </div>
        </div>

        @if (!_env.IsDevelopment())
        {
            <div class="mb-3">
                <script src="https://www.google.com/recaptcha/api.js" async defer></script>
                <div class="g-recaptcha" data-sitekey="@_config["Recaptcha:SiteKey"]"></div>
            </div>
        }

        <button type="submit" id="submitBtn" class="btn btn-careplus w-100 py-2 fs-6">Sign In to Workspace</button>
    </form>

    <p class="text-center mt-3 mb-2" style="font-size:13px;">
        New patient or customer? <a asp-controller="Account" asp-action="Register" class="fw-bold text-success text-decoration-none">Register Patient Account</a>
    </p>

    @if (_env.IsDevelopment())
    {
        <div class="demo-accounts text-start">
            <div class="fw-bold text-dark mb-1" style="font-size: 12px;"><i class="bi bi-key-fill text-success me-1"></i> Quick Demo Logins (Click to autofill):</div>
            <div>
                <span class="demo-account-chip" onclick="fillCreds('admin@careplus.ph', 'Admin@123')">👑 Main Admin</span>
                <span class="demo-account-chip" onclick="fillCreds('pharmacist@careplus.ph', 'Pharmacist@123')">💊 Pharmacist</span>
                <span class="demo-account-chip" onclick="fillCreds('cashier@careplus.ph', 'Cashier@123')">🛒 Cashier / POS</span>
                <span class="demo-account-chip" onclick="fillCreds('inventory@careplus.ph', 'Inventory@123')">📦 Inventory Coord.</span>
                <span class="demo-account-chip" onclick="fillCreds('customer@careplus.ph', 'Customer@123')">👤 Patient / Customer</span>
            </div>
        </div>
    }
</div>

<script>
    function fillCreds(email, pwd) {
        document.getElementById('emailInput').value = email;
        document.getElementById('passwordInput').value = pwd;
    }
</script>
