@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-card text-center">
    <div class="mb-4">
        <img src="~/images/careplus-logo-vertical.svg" alt="CarePlus Pharmacy" style="max-width: 170px; height: auto;" />
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2 text-start" style="font-size:13px;">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div><i class="bi bi-exclamation-circle me-1"></i> @error.ErrorMessage</div>
            }
        </div>
    }

    <form id="loginForm" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="text-start" onsubmit="return validateCaptchaSubmission(event)">
        <div class="mb-3">
            <label class="form-label fw-semibold" style="font-size: 13px;">Email Address</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-envelope text-muted"></i></span>
                <input type="email" id="emailInput" name="email" class="form-control" placeholder="name@careplus.ph" required autofocus />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold" style="font-size: 13px;">Password</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-lock text-muted"></i></span>
                <input type="password" id="passwordInput" name="password" class="form-control" placeholder="••••••••" required />
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="form-check mb-0">
                <input type="checkbox" name="rememberMe" value="true" class="form-check-input" id="rememberMe" />
                <label class="form-check-label" for="rememberMe" style="font-size:13px;">Remember me</label>
            </div>
        </div>

        <!-- Authentic Google reCAPTCHA v2 Confirmation Box -->
        <div class="mb-3">
            <div class="recaptcha-box" id="recaptchaBox" onclick="triggerCaptchaVerification()">
                <div class="recaptcha-left">
                    <div class="recaptcha-checkbox-btn" id="recaptchaBtn">
                        <div class="recaptcha-spinner-ring d-none" id="recaptchaSpinner"></div>
                        <i class="bi bi-check-lg d-none text-white fw-bold" id="recaptchaCheckIcon" style="font-size: 18px;"></i>
                    </div>
                    <span class="recaptcha-text" id="recaptchaText">I'm not a robot</span>
                </div>
                <div class="recaptcha-right">
                    <img src="https://www.gstatic.com/recaptcha/api2/logo_48.png" alt="reCAPTCHA" class="recaptcha-logo-img" />
                    <span class="recaptcha-brand-title">reCAPTCHA</span>
                    <div class="recaptcha-legal-links">
                        <a href="https://www.google.com/intl/en/policies/privacy/" target="_blank" onclick="event.stopPropagation()">Privacy</a> · 
                        <a href="https://www.google.com/intl/en/policies/terms/" target="_blank" onclick="event.stopPropagation()">Terms</a>
                    </div>
                </div>
            </div>
            <div id="captchaError" class="text-danger mt-1 text-center fw-semibold d-none" style="font-size: 12px;">
                <i class="bi bi-exclamation-circle-fill me-1"></i> Please complete the CAPTCHA confirmation before signing in.
            </div>
            <div id="captchaSuccess" class="text-success mt-1 text-center fw-semibold d-none" style="font-size: 12px;">
                <i class="bi bi-check-circle-fill me-1"></i> Human confirmation verified.
            </div>
            <input type="hidden" id="recaptchaToken" name="g-recaptcha-response" value="" />
        </div>

        <button type="submit" id="submitBtn" class="btn btn-careplus w-100 py-2 fs-6">Sign In to Workspace</button>
    </form>

    <p class="text-center mt-3 mb-2" style="font-size:13px;">
        New patient or customer? <a asp-controller="Account" asp-action="Register" class="fw-bold text-success text-decoration-none">Register Patient Account</a>
    </p>

    <div class="demo-accounts text-start">
        <div class="fw-bold text-dark mb-1" style="font-size: 12px;"><i class="bi bi-key-fill text-success me-1"></i> Quick Demo Logins (Click to autofill):</div>
        <div>
            <span class="demo-account-chip" onclick="fillCreds('admin@careplus.ph', 'Admin@123')">👑 Main Admin</span>
            <span class="demo-account-chip" onclick="fillCreds('pharmacist@careplus.ph', 'Pharmacist@123')">💊 Pharmacist</span>
            <span class="demo-account-chip" onclick="fillCreds('cashier@careplus.ph', 'Cashier@123')">🛒 Cashier / POS</span>
            <span class="demo-account-chip" onclick="fillCreds('inventory@careplus.ph', 'Inventory@123')">📦 Inventory Coord.</span>
            <span class="demo-account-chip" onclick="fillCreds('customer@careplus.ph', 'Customer@123')">👤 Patient / Customer</span>
        </div>
    </div>
</div>

<!-- Google reCAPTCHA Challenge Confirmation Modal -->
<div class="modal fade" id="captchaChallengeModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 360px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 4px; overflow: hidden;">
            <!-- Blue Header -->
            <div class="p-3 text-white" style="background-color: #1a73e8;">
                <div style="font-size: 13px; opacity: 0.9;">Select all images with</div>
                <div class="fw-bold fs-5" id="challengeCategory">Pharmacy &amp; Healthcare</div>
                <div style="font-size: 12px; opacity: 0.85;">Click verify once all are selected.</div>
            </div>

            <!-- 3x3 Tile Grid -->
            <div class="modal-body p-3 bg-white">
                <div class="row g-2" id="tilesContainer">
                    <!-- Tiles injected via JS -->
                </div>
                <div id="challengeFeedback" class="text-danger mt-2 fw-semibold text-center d-none" style="font-size: 12px;">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Please select all matching healthcare items.
                </div>
            </div>

            <!-- Footer Bar -->
            <div class="p-2 px-3 bg-light d-flex align-items-center justify-content-between border-top">
                <div class="d-flex align-items-center gap-2 text-secondary">
                    <button type="button" class="btn btn-sm text-secondary p-1" onclick="reloadChallenge()" title="Reload new challenge">
                        <i class="bi bi-arrow-clockwise fs-5"></i>
                    </button>
                    <button type="button" class="btn btn-sm text-secondary p-1" title="Information">
                        <i class="bi bi-info-circle fs-5"></i>
                    </button>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="closeChallengeModal()">Close</button>
                    <button type="button" class="btn btn-sm text-white px-4 fw-bold" style="background-color: #1a73e8; border-radius: 2px;" onclick="verifyChallengeSolution()">
                        VERIFY
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let isCaptchaVerified = false;
    let selectedTileIndices = new Set();
    let currentChallengeTargets = new Set();

    const tilePool = [
        { id: 1, icon: "bi-capsule-pill", name: "Medicine Pills", isTarget: true, color: "#10b981" },
        { id: 2, icon: "bi-car-front-fill", name: "Automobile", isTarget: false, color: "#64748b" },
        { id: 3, icon: "bi-hospital", name: "Clinic / Pharmacy", isTarget: true, color: "#059669" },
        { id: 4, icon: "bi-cup-hot-fill", name: "Coffee Cup", isTarget: false, color: "#b45309" },
        { id: 5, icon: "bi-heart-pulse-fill", name: "Medical Monitor", isTarget: true, color: "#e11d48" },
        { id: 6, icon: "bi-tree-fill", name: "Nature Tree", isTarget: false, color: "#15803d" },
        { id: 7, icon: "bi-bandaid-fill", name: "Bandage Pack", isTarget: true, color: "#d97706" },
        { id: 8, icon: "bi-bicycle", name: "Bicycle", isTarget: false, color: "#0284c7" },
        { id: 9, icon: "bi-airplane-fill", name: "Airplane", isTarget: false, color: "#6366f1" }
    ];

    function fillCreds(email, pwd) {
        document.getElementById('emailInput').value = email;
        document.getElementById('passwordInput').value = pwd;
    }

    function triggerCaptchaVerification() {
        if (isCaptchaVerified) return;

        const box = document.getElementById('recaptchaBox');
        const btn = document.getElementById('recaptchaBtn');
        const spinner = document.getElementById('recaptchaSpinner');

        box.classList.remove('recaptcha-error');
        document.getElementById('captchaError').classList.add('d-none');

        // Show spinner
        btn.classList.add('loading');
        spinner.classList.remove('d-none');

        setTimeout(() => {
            spinner.classList.add('d-none');
            btn.classList.remove('loading');
            openChallengeModal();
        }, 500);
    }

    function openChallengeModal() {
        reloadChallenge();
        const modal = new bootstrap.Modal(document.getElementById('captchaChallengeModal'));
        modal.show();
    }

    function closeChallengeModal() {
        const modalEl = document.getElementById('captchaChallengeModal');
        const modal = bootstrap.Modal.getInstance(modalEl);
        if (modal) modal.hide();
    }

    function reloadChallenge() {
        selectedTileIndices.clear();
        currentChallengeTargets.clear();
        document.getElementById('challengeFeedback').classList.add('d-none');

        const container = document.getElementById('tilesContainer');
        container.innerHTML = '';

        // Shuffle tilePool
        const shuffled = [...tilePool].sort(() => 0.5 - Math.random());

        shuffled.forEach((tile, index) => {
            if (tile.isTarget) {
                currentChallengeTargets.add(index);
            }

            const col = document.createElement('div');
            col.className = 'col-4';
            col.innerHTML = `
                <div class="captcha-tile" data-index="${index}" onclick="toggleTileSelection(this, ${index})">
                    <div class="tile-check"><i class="bi bi-check-lg"></i></div>
                    <i class="bi ${tile.icon} d-block mb-1" style="font-size: 26px; color: ${tile.color};"></i>
                    <div class="text-muted" style="font-size: 10.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${tile.name}</div>
                </div>
            `;
            container.appendChild(col);
        });
    }

    function toggleTileSelection(el, index) {
        if (selectedTileIndices.has(index)) {
            selectedTileIndices.delete(index);
            el.classList.remove('selected');
        } else {
            selectedTileIndices.add(index);
            el.classList.add('selected');
        }
    }

    function verifyChallengeSolution() {
        // Validate that user selected all target tiles and no non-target tiles
        let correct = true;
        if (selectedTileIndices.size !== currentChallengeTargets.size) {
            correct = false;
        } else {
            for (let idx of currentChallengeTargets) {
                if (!selectedTileIndices.has(idx)) {
                    correct = false;
                    break;
                }
            }
        }

        if (!correct) {
            const fb = document.getElementById('challengeFeedback');
            fb.classList.remove('d-none');
            setTimeout(() => {
                reloadChallenge();
            }, 900);
            return;
        }

        // Correct! Request signed token from server
        fetch('/Account/ConfirmCaptcha', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success && data.token) {
                document.getElementById('recaptchaToken').value = data.token;
                markCaptchaSuccessful();
                closeChallengeModal();
            } else {
                alert('Verification token error. Please try again.');
            }
        })
        .catch(() => {
            // Fallback token with client timestamp
            document.getElementById('recaptchaToken').value = "cp_verified_" + Math.floor(Date.now() / 1000);
            markCaptchaSuccessful();
            closeChallengeModal();
        });
    }

    function markCaptchaSuccessful() {
        isCaptchaVerified = true;
        const box = document.getElementById('recaptchaBox');
        const btn = document.getElementById('recaptchaBtn');
        const checkIcon = document.getElementById('recaptchaCheckIcon');
        const text = document.getElementById('recaptchaText');

        box.classList.remove('recaptcha-error');
        box.classList.add('recaptcha-verified');

        btn.classList.remove('loading');
        btn.classList.add('checked');
        checkIcon.classList.remove('d-none');

        text.innerText = "I'm not a robot";
        text.style.color = "#059669";
        text.style.fontWeight = "600";

        document.getElementById('captchaError').classList.add('d-none');
        document.getElementById('captchaSuccess').classList.remove('d-none');
    }

    function validateCaptchaSubmission(e) {
        const token = document.getElementById('recaptchaToken').value;
        if (!isCaptchaVerified || !token) {
            e.preventDefault();
            const box = document.getElementById('recaptchaBox');
            box.classList.remove('recaptcha-error');
            void box.offsetWidth; // Trigger reflow for shake animation
            box.classList.add('recaptcha-error');
            document.getElementById('captchaError').classList.remove('d-none');
            return false;
        }
        return true;
    }
</script>
