@{
    ViewData["Title"] = "Patient Registration";
}
<div class="auth-card text-center position-relative">
    <div class="mb-3">
        <img src="~/images/careplus-logo-vertical.svg" alt="CarePlus Pharmacy" style="max-width: 160px; height: auto;" />
    </div>
    <div class="mb-2 fw-bold text-success" style="font-size: 13px;">
        <i class="bi bi-heart-pulse me-1"></i> Patient &amp; Customer Portal
    </div>
    <p class="text-muted mb-4" style="font-size:13px;">Create an account to track your prescriptions, order history, and earn CarePlus loyalty rewards points.</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2 text-start" style="font-size:13px;">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div><i class="bi bi-exclamation-circle me-1"></i> @error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-controller="Account" asp-action="Register" method="post" class="text-start">
        <div class="mb-3">
            <label class="form-label fw-semibold" style="font-size: 13px;">Full Name</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-person text-muted"></i></span>
                <input type="text" name="fullName" class="form-control" placeholder="Juan Dela Cruz" required />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold" style="font-size: 13px;">Email Address</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-envelope text-muted"></i></span>
                <input type="email" name="email" class="form-control" placeholder="juan@mail.com" required />
            </div>
        </div>
        
        <div class="mb-3 position-relative">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label fw-semibold mb-0" style="font-size: 13px;">Password</label>
                <button type="button" class="btn btn-link p-0 text-decoration-none d-flex align-items-center gap-1" style="font-size: 12px; color: #1a73e8; font-weight: 500;" onclick="openGoogleSuggestion()">
                    <svg width="14" height="14" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span>Suggest strong password</span>
                </button>
            </div>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-lock text-muted"></i></span>
                <input type="password" id="regPassword" name="password" class="form-control" placeholder="••••••••" required minlength="6" autocomplete="new-password" onfocus="openGoogleSuggestion()" />
                <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('regPassword', this)" title="Show/Hide Password">
                    <i class="bi bi-eye"></i>
                </button>
            </div>

            <!-- Google Password Manager Style Suggestion Popup -->
            <div id="googlePasswordPopup" class="card shadow-lg border text-start mt-2 p-3 d-none position-absolute w-100" style="z-index: 1050; border-radius: 12px; border-color: #dadce0; background: #ffffff;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <svg width="20" height="20" viewBox="0 0 24 24">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                        </svg>
                        <span class="fw-bold text-dark" style="font-size: 13px;">Use suggested password</span>
                    </div>
                    <button type="button" class="btn btn-sm text-muted p-0" onclick="closeGoogleSuggestion()" title="Close">
                        <i class="bi bi-x-lg" style="font-size: 12px;"></i>
                    </button>
                </div>

                <div class="d-flex align-items-center justify-content-between p-2 rounded mb-2" style="background: #f8fafc; border: 1px dashed #94a3b8;">
                    <div id="googlePasswordDisplay" class="font-monospace fw-bold text-primary" style="font-size: 14.5px; letter-spacing: 0.5px;">
                        Loading...
                    </div>
                    <button type="button" class="btn btn-sm text-secondary p-0" onclick="refreshGooglePassword(event)" title="Generate another suggestion">
                        <i class="bi bi-arrow-clockwise fs-6"></i>
                    </button>
                </div>

                <div class="text-muted mb-3" style="font-size: 11.5px; line-height: 1.4;">
                    Google-grade strong password with uppercase, lowercase, numbers, and symbols. Saved to clipboard.
                </div>

                <div class="d-flex align-items-center justify-content-end gap-2">
                    <button type="button" class="btn btn-sm btn-light border text-secondary" style="font-size: 12.5px; border-radius: 6px;" onclick="closeGoogleSuggestion()">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-sm text-white fw-semibold px-3" style="background: #1a73e8; font-size: 12.5px; border-radius: 6px;" onclick="applyGooglePassword()">
                        Use suggested password
                    </button>
                </div>
            </div>

            <div id="pwFeedback" class="text-success mt-1 fw-semibold d-none" style="font-size: 11.5px;">
                <i class="bi bi-check-circle-fill me-1"></i> Strong password filled and copied to clipboard!
            </div>
        </div>

        <button type="submit" class="btn btn-careplus w-100 py-2 fs-6">Enroll &amp; Create Account</button>
    </form>

    <p class="text-center mt-3 mb-0" style="font-size:13px;">
        Already registered? <a asp-controller="Account" asp-action="Login" class="fw-bold text-success text-decoration-none">Sign in here</a>
    </p>
</div>

<script>
    let currentGooglePassword = "";

    function generateGooglePassword() {
        // Generates 4 blocks of 4 chars: e.g. w7K9-mP2x-4qLt-vY8j
        const upper = "ABCDEFGHJKLMNPQRSTUVWXYZ";
        const lower = "abcdefghijkmnopqrstuvwxyz";
        const digits = "23456789";
        const symbols = "!@@#$%&*";
        const allChars = upper + lower + digits + symbols;

        let chars = [];
        // Ensure representation from all sets
        chars.push(upper[Math.floor(Math.random() * upper.length)]);
        chars.push(lower[Math.floor(Math.random() * lower.length)]);
        chars.push(digits[Math.floor(Math.random() * digits.length)]);
        chars.push(symbols[Math.floor(Math.random() * symbols.length)]);

        const randomBuffer = new Uint32Array(12);
        window.crypto.getRandomValues(randomBuffer);
        for (let i = 0; i < 12; i++) {
            chars.push(allChars[randomBuffer[i] % allChars.length]);
        }

        // Shuffle randomly
        chars = chars.sort(() => 0.5 - Math.random());

        // Format into 4 chunks separated by hyphens (Google Chrome style)
        const chunk1 = chars.slice(0, 4).join('');
        const chunk2 = chars.slice(4, 8).join('');
        const chunk3 = chars.slice(8, 12).join('');
        const chunk4 = chars.slice(12, 16).join('');

        return `${chunk1}-${chunk2}-${chunk3}-${chunk4}`;
    }

    function openGoogleSuggestion() {
        if (!currentGooglePassword) {
            currentGooglePassword = generateGooglePassword();
        }
        document.getElementById('googlePasswordDisplay').innerText = currentGooglePassword;
        const popup = document.getElementById('googlePasswordPopup');
        popup.classList.remove('d-none');
    }

    function closeGoogleSuggestion() {
        document.getElementById('googlePasswordPopup').classList.add('d-none');
    }

    function refreshGooglePassword(e) {
        if (e) e.stopPropagation();
        currentGooglePassword = generateGooglePassword();
        document.getElementById('googlePasswordDisplay').innerText = currentGooglePassword;
    }

    function applyGooglePassword() {
        if (!currentGooglePassword) {
            currentGooglePassword = generateGooglePassword();
        }
        const input = document.getElementById('regPassword');
        input.value = currentGooglePassword;
        input.type = 'text'; // Reveal so the user can see their generated password

        // Copy to clipboard
        navigator.clipboard.writeText(currentGooglePassword).catch(() => {});

        closeGoogleSuggestion();

        const fb = document.getElementById('pwFeedback');
        if (fb) {
            fb.classList.remove('d-none');
            setTimeout(() => fb.classList.add('d-none'), 6000);
        }
    }

    function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye');
        }
    }
</script>
