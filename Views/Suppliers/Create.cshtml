@model Supplier
@{ ViewData["Title"] = "Add Supplier"; }
<div class="table-card p-4" style="max-width:520px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <div class="mb-3"><label class="form-label">Supplier name</label><input asp-for="Name" class="form-control" required /></div>
        <div class="mb-3"><label class="form-label">Contact number</label><input asp-for="ContactNumber" class="form-control" maxlength="9" required /></div>
        <div class="mb-3"><label class="form-label">Email</label><input asp-for="Email" type="email" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">Address</label><input asp-for="Address" class="form-control" /></div>
        <button type="submit" class="btn btn-accent">Add Supplier</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
