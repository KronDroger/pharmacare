@model List<Supplier>
@{ ViewData["Title"] = "Suppliers"; }

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <form method="get" class="d-flex" style="max-width:320px;">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search supplier..." />
        <button class="btn btn-outline-secondary ms-2"><i class="bi bi-search"></i></button>
    </form>
    <a asp-action="Create" class="btn btn-accent"><i class="bi bi-plus-lg"></i> Add Supplier</a>
</div>

<div class="table-card">
    <table class="table align-middle mb-0">
        <thead><tr><th>Name</th><th>Contact</th><th>Email</th><th>Address</th><th>Action</th></tr></thead>
        <tbody>
            @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">No suppliers found.</td></tr> }
            @foreach (var s in Model)
            {
                <tr>
                    <td class="fw-semibold">@s.Name</td><td>@s.ContactNumber</td><td>@s.Email</td><td>@s.Address</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@s.Id" class="action-icon text-secondary me-2" title="Edit Supplier"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="@s.Id" class="action-icon text-danger" title="Archive Supplier"><i class="bi bi-archive"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
