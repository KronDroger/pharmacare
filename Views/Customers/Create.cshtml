@model Customer
@{ ViewData["Title"] = "Add Customer"; }
<div class="table-card p-4" style="max-width:520px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <div class="mb-3"><label class="form-label">Full name</label><input asp-for="FullName" class="form-control" required /></div>
        <div class="mb-3"><label class="form-label">Phone</label><input asp-for="Phone" class="form-control" required /></div>
        <div class="mb-3"><label class="form-label">Email</label><input asp-for="Email" type="email" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">Address</label><input asp-for="Address" class="form-control" /></div>
        <div class="row">
            <div class="col-6 mb-3"><label class="form-label">City</label><input asp-for="City" class="form-control" /></div>
            <div class="col-6 mb-3"><label class="form-label">Gender</label><select asp-for="Gender" class="form-select"><option value="">— Select —</option><option>Male</option><option>Female</option><option>Other</option></select></div>
        </div>
        <div class="mb-3"><label class="form-label">Date of Birth</label><input asp-for="DateOfBirth" type="date" class="form-control" /></div>
        <button type="submit" class="btn btn-accent">Add Customer</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
