@model Customer
@{
    ViewData["Title"] = $"{Model.FullName} - Patient Profile & CRM";
    var totalSpent = Model.Sales.Sum(s => s.TotalAmount);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0 text-dark">@Model.FullName</h4>
        <div class="text-muted" style="font-size: 13px;">
            Patient ID #@Model.Id · Registered: @Model.DateRegistered.ToString("yyyy-MM-dd")
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Sales" asp-action="Create" class="btn btn-sm btn-accent">
            <i class="bi bi-cart-plus me-1"></i> New Sale
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-pencil me-1"></i> Edit Profile
        </a>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Directory</a>
    </div>
</div>

<!-- CRM Profile Header -->
<div class="table-card p-4 mb-4">
    <div class="row g-3 align-items-center">
        <div class="col-md-3 border-end">
            <div class="text-muted text-uppercase" style="font-size: 11px; font-weight: 700;">CRM Loyalty Tier</div>
            <div class="mt-1">
                @if (Model.LoyaltyPoints >= 500)
                {
                    <span class="badge-tier-platinum fs-6">👑 @Model.Tier</span>
                }
                else if (Model.LoyaltyPoints >= 250)
                {
                    <span class="badge-tier-gold fs-6">⭐ @Model.Tier</span>
                }
                else if (Model.LoyaltyPoints >= 100)
                {
                    <span class="badge-tier-silver fs-6">🛡️ @Model.Tier</span>
                }
                else
                {
                    <span class="badge-tier-bronze fs-6">🏷️ @Model.Tier</span>
                }
            </div>
            <div class="fs-4 fw-bold text-success mt-2">@Model.LoyaltyPoints <span style="font-size: 13px; font-weight: 500;">points</span></div>
            <div class="text-muted" style="font-size: 11px;">Redeemable for ₱@Model.LoyaltyPoints.ToString("N2") discount</div>
        </div>
        <div class="col-md-3 border-end">
            <div class="text-muted text-uppercase" style="font-size: 11px; font-weight: 700;">Lifetime Purchases</div>
            <div class="fs-4 fw-bold text-dark mt-1">₱@totalSpent.ToString("N2")</div>
            <div class="text-muted" style="font-size: 11.5px;">@Model.Sales.Count total transactions</div>
        </div>
        <div class="col-md-6">
            <div class="text-muted text-uppercase" style="font-size: 11px; font-weight: 700;">Contact &amp; Delivery Information</div>
            <div class="mt-1">
                <i class="bi bi-telephone text-success me-2"></i><strong>@Model.Phone</strong>
            </div>
            @if (!string.IsNullOrEmpty(Model.Email))
            {
                <div><i class="bi bi-envelope text-muted me-2"></i>@Model.Email</div>
            }
            <div><i class="bi bi-geo-alt text-danger me-2"></i>@(Model.Address ?? "No physical address provided")</div>
        </div>
    </div>
</div>

<!-- Purchase History Table -->
<div class="table-card mb-4">
    <div class="table-card-header">
        <div class="fw-bold fs-6" style="color: var(--cp-forest-deep);"><i class="bi bi-bag-check text-success me-2"></i>Patient Dispensing &amp; Purchase History</div>
        <span class="badge bg-light text-dark border">@Model.Sales.Count Record(s)</span>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Invoice / Sale #</th>
                    <th>Date</th>
                    <th>Payment</th>
                    <th>Items Purchased</th>
                    <th>Amount</th>
                    <th class="text-end">Receipt</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Sales.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No purchases recorded for this customer yet.</td>
                    </tr>
                }
                @foreach (var s in Model.Sales.OrderByDescending(s => s.SaleDate))
                {
                    <tr>
                        <td class="fw-bold">#@s.Id</td>
                        <td>@s.SaleDate.ToString("yyyy-MM-dd")</td>
                        <td><span class="badge bg-light text-dark border">@s.PaymentMethod</span></td>
                        <td>
                            @string.Join(", ", s.Details.Select(d => $"{d.Medicine?.Name} ({d.Quantity})"))
                        </td>
                        <td class="fw-bold text-success">₱@s.TotalAmount.ToString("N2")</td>
                        <td class="text-end">
                            <a asp-controller="Sales" asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size: 12px;">
                                <i class="bi bi-receipt me-1"></i> Receipt
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Prescriptions on File -->
<div class="table-card">
    <div class="table-card-header">
        <div class="fw-bold fs-6" style="color: var(--cp-forest-deep);"><i class="bi bi-file-earmark-medical text-primary me-2"></i>Doctor Prescriptions on File</div>
        <a asp-controller="Prescriptions" asp-action="Create" class="btn btn-sm btn-outline-careplus">
            <i class="bi bi-plus-lg me-1"></i> New Prescription
        </a>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Rx ID</th>
                    <th>Prescribing Doctor</th>
                    <th>Date Prescribed</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Prescriptions.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No doctor prescriptions on file.</td>
                    </tr>
                }
                @foreach (var rx in Model.Prescriptions.OrderByDescending(r => r.DatePrescribed))
                {
                    <tr>
                        <td class="fw-bold">#RX-@rx.Id.ToString("D4")</td>
                        <td>@rx.DoctorName</td>
                        <td>@rx.DatePrescribed.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (rx.Status == PrescriptionStatus.Fulfilled)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Fulfilled</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (rx.Status == PrescriptionStatus.Pending)
                            {
                                <a asp-controller="Sales" asp-action="Create" asp-route-prescriptionId="@rx.Id" class="btn btn-sm btn-accent py-1 px-2" style="font-size: 12px;">
                                    <i class="bi bi-cart3 me-1"></i> Dispense in POS
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
